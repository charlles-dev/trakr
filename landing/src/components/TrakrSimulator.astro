---
// Trakr Simulator Mini-Game 3D - UX OVERHAUL (FIXED)
---

<div id="trakr-game-container" class="w-full max-w-6xl mx-auto rounded-[1rem] overflow-hidden border border-[#222] shadow-[0_0_80px_rgba(255,107,80,0.15)] relative mt-32 mb-32 bg-[#050505]">
    
    <!-- Top Bar -->
    <div class="absolute top-0 left-0 w-full h-8 bg-[#0a0a0a] border-b border-[#222] flex items-center px-4 justify-between z-20 pointer-events-none">
        <div class="flex gap-2">
            <div class="w-2.5 h-2.5 rounded-full bg-[#333]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#333]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#333]"></div>
        </div>
        <div class="text-[#888] font-mono text-[9px] uppercase tracking-[0.3em] flex items-center gap-2">
            <iconify-icon icon="lucide:cpu"></iconify-icon> Trakr_3D_Engine_v2.exe
        </div>
    </div>

    <!-- UI Overlay / HUD -->
    <div id="ui-layer" class="absolute top-8 left-0 w-full p-6 pointer-events-none z-10 hidden flex-col items-center">
        <div class="bg-black/60 backdrop-blur-md border border-[#333] p-6 rounded-xl shadow-2xl flex flex-col items-center min-w-[300px]">
            <div id="ui-title" class="text-[#FF6B50] font-mono text-sm tracking-[0.3em] font-bold uppercase mb-2">
                [ Phase 1: Assembly ]
            </div>
            <div id="ui-subtitle" class="text-[#aaa] text-xs font-mono text-center mb-6 h-8">
                Drag and drop the components to their designated slots.
            </div>
            <div id="ui-progress" class="w-full h-1 bg-[#222] rounded mb-6 overflow-hidden">
                <div id="ui-progress-bar" class="h-full bg-[#FF6B50] w-0 transition-all duration-500"></div>
            </div>
            <button id="sync-btn" class="w-full py-3 bg-[#FF6B50]/10 border border-[#FF6B50] text-[#FF6B50] font-mono text-xs font-bold tracking-[0.2em] uppercase hidden pointer-events-auto hover:bg-[#FF6B50] hover:text-black transition-all rounded shadow-[0_0_15px_rgba(255,107,80,0)] hover:shadow-[0_0_15px_rgba(255,107,80,0.5)]">
                Sync Bluetooth
            </button>
            <button id="test-alarm-btn" class="w-full py-3 bg-red-600/10 border border-red-600 text-red-500 font-mono text-xs font-bold tracking-[0.2em] uppercase hidden pointer-events-auto hover:bg-red-600 hover:text-white transition-all rounded shadow-[0_0_15px_rgba(255,0,0,0)] hover:shadow-[0_0_15px_rgba(255,0,0,0.5)]">
                Remove Tool (Test)
            </button>
        </div>
    </div>

    <!-- Start Overlay -->
    <div id="game-overlay" class="absolute inset-0 bg-black/80 backdrop-blur-sm z-30 flex flex-col items-center justify-center p-6">
        <div class="w-16 h-16 border border-[#FF6B50] rounded-full flex items-center justify-center mb-6">
            <iconify-icon icon="lucide:box" class="text-[#FF6B50] text-3xl"></iconify-icon>
        </div>
        <h3 class="text-white font-mono text-2xl tracking-[0.2em] mb-4 text-center">TRAKR 3D SIMULATOR</h3>
        <p class="text-[#888] text-sm max-w-lg text-center mb-10 leading-relaxed font-mono">
            Assemble the hardware components onto the mainboard. Complete the software synchronization, and test the real-time UHF RFID tracking physics.
        </p>
        <button id="start-game-btn" class="px-10 py-4 bg-[#FF6B50] text-black font-mono text-xs font-bold uppercase tracking-[0.3em] hover:bg-white transition-colors rounded pointer-events-auto shadow-[0_0_30px_rgba(255,107,80,0.3)] hover:shadow-[0_0_40px_rgba(255,255,255,0.4)]">
            Initialize Engine
        </button>
    </div>
    
    <!-- 3D Canvas -->
    <div id="three-container" class="w-full h-[600px] md:h-[750px] outline-none select-none cursor-grab active:cursor-grabbing"></div>
</div>

<!-- Three.js Libraries -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/DragControls.js"></script>

<script is:inline>
    // --- Audio Context Engine ---
    const AudioEngine = {
        ctx: null,
        init: function() {
            if(!this.ctx) this.ctx = new (window.AudioContext || window.webkitAudioContext)();
        },
        playTone: function(freq, type, duration, vol=0.1) {
            if(!this.ctx) return;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = type;
            osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
            
            gain.gain.setValueAtTime(vol, this.ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);
            
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start();
            osc.stop(this.ctx.currentTime + duration);
        },
        snap: function() { this.playTone(800, 'square', 0.1, 0.05); this.playTone(1200, 'sine', 0.15, 0.05); },
        boot: function() { this.playTone(400, 'sine', 0.5, 0.1); setTimeout(()=>this.playTone(600, 'sine', 0.5, 0.1), 200); setTimeout(()=>this.playTone(800, 'sine', 0.8, 0.1), 400); },
        alarm: function() { this.playTone(1000, 'sawtooth', 0.4, 0.2); setTimeout(()=>this.playTone(800, 'sawtooth', 0.4, 0.2), 200); }
    };

    // --- High-Quality Canvas Textures ---
    function createPCBTexture() {
        const canvas = document.createElement('canvas');
        canvas.width = 1024; canvas.height = 1024;
        const ctx = canvas.getContext('2d');
        
        // Base sleek dark green
        ctx.fillStyle = '#0a150e';
        ctx.fillRect(0, 0, 1024, 1024);
        
        // Clean Grid
        ctx.strokeStyle = '#112215';
        ctx.lineWidth = 2;
        for(let i=0; i<1024; i+=32) {
            ctx.beginPath(); ctx.moveTo(i, 0); ctx.lineTo(i, 1024); ctx.stroke();
            ctx.beginPath(); ctx.moveTo(0, i); ctx.lineTo(1024, i); ctx.stroke();
        }

        // Draw symmetric circuitry lines
        ctx.strokeStyle = '#338844';
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo(200, 200); ctx.lineTo(200, 800);
        ctx.moveTo(800, 200); ctx.lineTo(800, 800);
        ctx.moveTo(200, 200); ctx.lineTo(800, 200);
        ctx.moveTo(200, 800); ctx.lineTo(800, 800);
        ctx.stroke();

        return new THREE.CanvasTexture(canvas);
    }

    function createESPTexture() {
        const canvas = document.createElement('canvas');
        canvas.width = 512; canvas.height = 512;
        const ctx = canvas.getContext('2d');
        
        // Black PCB Base
        ctx.fillStyle = '#111111';
        ctx.fillRect(0, 0, 512, 512);

        // Gold Pins on edges
        ctx.fillStyle = '#d4af37';
        for(let i=40; i<480; i+=25) {
            ctx.fillRect(0, i, 20, 10);
            ctx.fillRect(492, i, 20, 10);
        }

        // Silver Shield
        ctx.fillStyle = '#dddddd';
        ctx.fillRect(100, 50, 312, 350);
        
        // Logo
        ctx.fillStyle = '#333333';
        ctx.font = 'bold 50px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('ESP32', 256, 230);
        ctx.font = '30px sans-serif';
        ctx.fillText('WiFi / BLE', 256, 280);

        // Antenna zig-zag on top
        ctx.strokeStyle = '#d4af37';
        ctx.lineWidth = 15;
        ctx.beginPath();
        ctx.moveTo(150, 20); ctx.lineTo(180, 20); ctx.lineTo(180, 40); ctx.lineTo(210, 40); ctx.lineTo(210, 20); ctx.lineTo(240, 20); ctx.lineTo(240, 40);
        ctx.stroke();

        return new THREE.CanvasTexture(canvas);
    }

    function createAntennaTexture() {
        const canvas = document.createElement('canvas');
        canvas.width = 512; canvas.height = 512;
        const ctx = canvas.getContext('2d');
        
        // White industrial panel
        ctx.fillStyle = '#f0f0f0';
        ctx.fillRect(0, 0, 512, 512);

        // Tech borders
        ctx.strokeStyle = '#cccccc';
        ctx.lineWidth = 10;
        ctx.strokeRect(20, 20, 472, 472);
        
        // Inner square (patch)
        ctx.fillStyle = '#e0e0e0';
        ctx.fillRect(100, 100, 312, 312);

        ctx.fillStyle = '#888888';
        ctx.font = 'bold 40px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('UHF RFID', 256, 250);
        ctx.font = '20px sans-serif';
        ctx.fillText('900 MHz', 256, 290);

        return new THREE.CanvasTexture(canvas);
    }

    function createPhoneTexture() {
        const canvas = document.createElement('canvas');
        canvas.width = 256; canvas.height = 512;
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = '#050510';
        ctx.fillRect(0, 0, 256, 512);
        
        // Radar circles
        ctx.strokeStyle = '#00ff88';
        ctx.lineWidth = 2;
        ctx.beginPath(); ctx.arc(128, 256, 60, 0, Math.PI*2); ctx.stroke();
        ctx.beginPath(); ctx.arc(128, 256, 90, 0, Math.PI*2); ctx.stroke();
        
        ctx.fillStyle = '#00ff88';
        ctx.font = '20px monospace';
        ctx.fillText("SYNC.READY", 70, 50);
        return new THREE.CanvasTexture(canvas);
    }

    // --- Boot Game ---
    const startBtn = document.getElementById('start-game-btn');
    if (startBtn) {
        startBtn.addEventListener('click', () => {
            AudioEngine.init();
            AudioEngine.playTone(300, 'sine', 0.1);
            document.getElementById('game-overlay').style.display = 'none';
            document.getElementById('ui-layer').classList.remove('hidden');
            document.getElementById('ui-layer').classList.add('flex');
            initThreeEngine();
        });
    }

    function initThreeEngine() {
        const container = document.getElementById('three-container');
        const width = container.clientWidth;
        const height = container.clientHeight;

        // Scene & Camera
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x050505);
        scene.fog = new THREE.Fog(0x050505, 10, 40);

        const camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 100);
        camera.position.set(-10, 15, 10);

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        container.appendChild(renderer.domElement);

        // OrbitControls
        const orbit = new THREE.OrbitControls(camera, renderer.domElement);
        orbit.enableDamping = true;
        orbit.dampingFactor = 0.05;
        orbit.maxPolarAngle = Math.PI / 2.5;
        orbit.minDistance = 5;
        orbit.maxDistance = 25;

        // Lighting
        const ambient = new THREE.AmbientLight(0xffffff, 0.7);
        scene.add(ambient);

        const spotLight = new THREE.SpotLight(0xffffff, 1.0);
        spotLight.position.set(0, 20, 0);
        spotLight.angle = Math.PI / 4;
        spotLight.penumbra = 0.2;
        spotLight.castShadow = true;
        spotLight.shadow.mapSize.width = 1024;
        spotLight.shadow.mapSize.height = 1024;
        scene.add(spotLight);

        // Grid
        const grid = new THREE.GridHelper(50, 50, 0x222222, 0x111111);
        grid.position.y = -0.1;
        scene.add(grid);

        // --- Materials & Textures ---
        const pcbTex = createPCBTexture();
        const espTex = createESPTexture();
        const antTex = createAntennaTexture();
        const phoneTex = createPhoneTexture();
        
        const matBoard = new THREE.MeshStandardMaterial({ map: pcbTex, roughness: 0.3, metalness: 0.1 });
        const matSlot = new THREE.MeshStandardMaterial({ color: 0xFF6B50, wireframe: true, transparent: true, opacity: 0.2 });
        
        const matESPBase = new THREE.MeshStandardMaterial({ color: 0x111111, roughness: 0.8 });
        const matESPTop = new THREE.MeshStandardMaterial({ map: espTex, roughness: 0.5 });
        const espMaterials = [matESPBase, matESPBase, matESPTop, matESPBase, matESPBase, matESPBase];
        
        const matAntBase = new THREE.MeshStandardMaterial({ color: 0xe0e0e0, roughness: 0.9 });
        const matAntTop = new THREE.MeshStandardMaterial({ map: antTex, roughness: 0.8 });
        const antMaterials = [matAntBase, matAntBase, matAntTop, matAntBase, matAntBase, matAntBase];

        const matBattery = new THREE.MeshStandardMaterial({ color: 0x1877f2, metalness: 0.4, roughness: 0.5 });
        const matBuzzer = new THREE.MeshStandardMaterial({ color: 0x0a0a0a, roughness: 0.9 });
        
        // --- Modeling ---
        const draggables = [];
        const targets = [];

        // 1. Mainboard
        const mainboard = new THREE.Mesh(new THREE.BoxGeometry(10, 0.4, 7), matBoard);
        mainboard.receiveShadow = true;
        mainboard.castShadow = true;
        scene.add(mainboard);

        // LED
        const ledMat = new THREE.MeshBasicMaterial({ color: 0x333333 });
        const ledMesh = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.1, 0.3), ledMat);
        ledMesh.position.set(-4, 0.25, -2.5);
        scene.add(ledMesh);
        
        const ledLight = new THREE.PointLight(0x000000, 0, 5);
        ledLight.position.set(-4, 1, -2.5);
        scene.add(ledLight);

        // Slots
        function createSlot(x, z, w, d, name) {
            const slot = new THREE.Mesh(new THREE.BoxGeometry(w, 0.5, d), matSlot);
            slot.position.set(x, 0.25, z);
            slot.userData = { id: name, filled: false };
            scene.add(slot);
            targets.push(slot);
            return slot;
        }
        createSlot(-2, 0, 2.5, 3.5, 'esp');
        createSlot(3, -1.5, 1.2, 3.8, 'batt');
        createSlot(3, 2, 1.2, 1.2, 'buzz');
        createSlot(-0.5, 0, 3.5, 3.5, 'ant');

        // Draggable Factory (Single Meshes to fix DragControls bugs)
        function createDraggable(geometry, materials, startPos, name) {
            const mesh = new THREE.Mesh(geometry, materials);
            mesh.position.copy(startPos);
            mesh.userData = { id: name, isPlaced: false };
            mesh.castShadow = true;
            mesh.receiveShadow = true;
            scene.add(mesh);
            draggables.push(mesh);
            return mesh;
        }

        // ESP32 (Single Mesh)
        createDraggable(new THREE.BoxGeometry(2.3, 0.5, 3.3), espMaterials, new THREE.Vector3(-8, 0.25, -4), 'esp');

        // Battery (Single Mesh)
        const battGeo = new THREE.CylinderGeometry(0.5, 0.5, 3.6, 24);
        battGeo.rotateX(Math.PI/2);
        createDraggable(battGeo, matBattery, new THREE.Vector3(8, 0.5, -4), 'batt');

        // Buzzer (Single Mesh)
        const buzzGeo = new THREE.CylinderGeometry(0.5, 0.5, 1, 16);
        createDraggable(buzzGeo, matBuzzer, new THREE.Vector3(8, 0.5, 4), 'buzz');

        // Antenna (Single Mesh)
        createDraggable(new THREE.BoxGeometry(3.3, 0.2, 3.3), antMaterials, new THREE.Vector3(-8, 0.1, 4), 'ant');


        // --- Particles (Sparks) ---
        const sparkCount = 100;
        const sparkGeo = new THREE.BufferGeometry();
        const sparkPos = new Float32Array(sparkCount * 3);
        const sparkVel = [];
        for(let i=0; i<sparkCount; i++) {
            sparkPos[i*3] = 0; sparkPos[i*3+1] = -100; sparkPos[i*3+2] = 0; // hidden
            sparkVel.push(new THREE.Vector3(0,0,0));
        }
        sparkGeo.setAttribute('position', new THREE.BufferAttribute(sparkPos, 3));
        const sparkMat = new THREE.PointsMaterial({ color: 0xFFD700, size: 0.1, transparent: true, blending: THREE.AdditiveBlending });
        const sparks = new THREE.Points(sparkGeo, sparkMat);
        scene.add(sparks);

        function emitSparks(pos) {
            const posAttr = sparks.geometry.attributes.position;
            for(let i=0; i<sparkCount; i++) {
                posAttr.setXYZ(i, pos.x, pos.y + 0.5, pos.z);
                sparkVel[i].set((Math.random()-0.5)*10, Math.random()*10, (Math.random()-0.5)*10);
            }
            posAttr.needsUpdate = true;
        }

        // --- Fixed Drag Logic ---
        const dragControls = new THREE.DragControls(draggables, camera, renderer.domElement);
        
        let componentsPlaced = 0;

        dragControls.addEventListener('dragstart', (e) => {
            orbit.enabled = false;
            e.object.position.y += 1;
            container.style.cursor = 'grabbing';
            AudioEngine.playTone(300, 'triangle', 0.1, 0.02);
        });

        dragControls.addEventListener('drag', (e) => {
            e.object.position.y = 1.5;
        });

        dragControls.addEventListener('dragend', (e) => {
            orbit.enabled = true;
            container.style.cursor = 'grab';
            
            const obj = e.object;
            const name = obj.userData.id;

            const target = targets.find(t => t.userData.id === name);
            if (target && !target.userData.filled) {
                if (obj.position.distanceTo(target.position) < 3.5) {
                    obj.position.set(target.position.x, target.position.y + 0.1, target.position.z);
                    
                    if(name === 'batt' || name === 'buzz') obj.position.y = 0.6;
                    if(name === 'esp') obj.position.y = 0.45;
                    if(name === 'ant') obj.position.y = 0.3;

                    target.userData.filled = true;
                    target.material.color.setHex(0x00FF00);
                    target.material.opacity = 0.8;
                    setTimeout(()=> target.material.opacity = 0.2, 200);
                    
                    emitSparks(target.position);
                    AudioEngine.snap();
                    
                    componentsPlaced++;
                    document.getElementById('ui-progress-bar').style.width = (componentsPlaced/4)*100 + '%';
                    
                    const hitIdx = draggables.indexOf(obj);
                    if(hitIdx > -1) draggables.splice(hitIdx, 1);

                    if (componentsPlaced === 4) completePhase1();
                } else {
                    if(name === 'batt' || name === 'buzz') obj.position.y = 0.5;
                    else if(name === 'esp') obj.position.y = 0.25;
                    else obj.position.y = 0.1; 
                }
            }
        });

        dragControls.addEventListener('hoveron', () => container.style.cursor = 'grab');
        dragControls.addEventListener('hoveroff', () => container.style.cursor = 'auto');

        // --- Phase Management ---
        let smartphone;
        let isAlarm = false;

        function completePhase1() {
            document.getElementById('ui-title').innerText = '[ BOOTING SYSTEM ]';
            document.getElementById('ui-subtitle').innerText = 'Initializing Edge Kernel...';
            AudioEngine.boot();

            setTimeout(() => {
                ledMat.color.setHex(0x00FF00);
                ledLight.color.setHex(0x00FF00);
                ledLight.intensity = 2;
                startPhase2();
            }, 1500);
        }

        function startPhase2() {
            document.getElementById('ui-title').innerText = '[ PHASE 2: PAIRING ]';
            document.getElementById('ui-subtitle').innerText = 'System broadcasting BLE. Pair via software.';
            
            const targetCam = new THREE.Vector3(-12, 10, 0);
            const cx = camera.position.x, cy = camera.position.y, cz = camera.position.z;
            let t = 0;
            const cAnim = setInterval(() => {
                t+=0.02;
                if(t>1) { t=1; clearInterval(cAnim); }
                camera.position.set(cx + (targetCam.x-cx)*t, cy + (targetCam.y-cy)*t, cz + (targetCam.z-cz)*t);
                orbit.target.set(-10, 0, 0);
            }, 16);

            smartphone = new THREE.Group();
            const pBody = new THREE.Mesh(new THREE.BoxGeometry(4.2, 0.3, 7.5), new THREE.MeshStandardMaterial({color:0x222, metalness:0.8, roughness:0.2}));
            const pScreen = new THREE.Mesh(new THREE.PlaneGeometry(3.8, 7), new THREE.MeshBasicMaterial({map: phoneTex}));
            pScreen.rotation.x = -Math.PI/2;
            pScreen.position.y = 0.16;
            smartphone.add(pBody, pScreen);
            
            smartphone.position.set(-20, 0.2, 0);
            smartphone.rotation.y = Math.PI/12;
            scene.add(smartphone);

            let pt = 0;
            const pAnim = setInterval(() => {
                pt+=0.05;
                if(pt>1) clearInterval(pAnim);
                smartphone.position.x = -20 + (-10 - -20)*pt;
            }, 16);

            const syncBtn = document.getElementById('sync-btn');
            syncBtn.classList.remove('hidden');

            syncBtn.onclick = () => {
                syncBtn.classList.add('hidden');
                AudioEngine.playTone(1500, 'sine', 0.2);
                document.getElementById('ui-subtitle').innerText = 'Handshake success. Neural link online.';
                ledMat.color.setHex(0x00aaff);
                ledLight.color.setHex(0x00aaff);
                setTimeout(() => startPhase3(), 2000);
            };
        }

        let scanningRings = [];
        let tool3D;

        function startPhase3() {
            document.getElementById('ui-title').innerText = '[ PHASE 3: LIVE TRACKING ]';
            document.getElementById('ui-subtitle').innerText = 'UHF Antenna scanning area. Remove asset to test security.';
            
            orbit.target.set(0,0,0);
            camera.position.set(0, 15, 12);

            const toolGeo = new THREE.BoxGeometry(0.5, 0.5, 3);
            const toolMat = new THREE.MeshStandardMaterial({ color: 0xffaa00 });
            tool3D = new THREE.Mesh(toolGeo, toolMat);
            tool3D.position.set(0, 0.5, 0);
            scene.add(tool3D);

            const ringGeo = new THREE.RingGeometry(1, 1.2, 32);
            const ringMat = new THREE.MeshBasicMaterial({color: 0x00aaff, side: THREE.DoubleSide, transparent: true, opacity: 0.8});
            
            setInterval(() => {
                if(isAlarm) return;
                const ring = new THREE.Mesh(ringGeo, ringMat.clone());
                ring.rotation.x = -Math.PI/2;
                ring.position.set(-0.5, 1, 0);
                scene.add(ring);
                scanningRings.push(ring);
            }, 1000);

            const testBtn = document.getElementById('test-alarm-btn');
            testBtn.classList.remove('hidden');

            testBtn.onclick = () => {
                testBtn.classList.add('hidden');
                const remAnim = setInterval(() => {
                    if (tool3D) tool3D.position.y += 0.2;
                    if(tool3D && tool3D.position.y > 10) {
                        clearInterval(remAnim);
                        triggerAlarm();
                    }
                }, 16);
            };
        }

        function triggerAlarm() {
            isAlarm = true;
            document.getElementById('ui-title').innerText = '[ ALARM ACTIVE ]';
            document.getElementById('ui-title').classList.replace('text-[#FF6B50]', 'text-red-500');
            document.getElementById('ui-subtitle').innerText = 'ASSET BREACH DETECTED!';
            ledMat.color.setHex(0xFF0000);
            ledLight.color.setHex(0xFF0000);
            ledLight.intensity = 5;

            let alarmCount = 0;
            const sirentInt = setInterval(() => {
                AudioEngine.alarm();
                alarmCount++;
                if(alarmCount > 10) clearInterval(sirentInt);
            }, 800);

            const endBtn = document.getElementById('sync-btn');
            endBtn.classList.remove('hidden', 'bg-[#FF6B50]/10', 'border-[#FF6B50]', 'text-[#FF6B50]');
            endBtn.classList.add('bg-red-600', 'text-white', 'border-red-600', 'hover:bg-red-500');
            endBtn.innerText = 'Purchase Fleet';
            endBtn.onclick = () => { window.location.hash = '#contact'; };
        }

        // --- Render Loop ---
        const clock = new THREE.Clock();
        function animate() {
            requestAnimationFrame(animate);
            orbit.update();
            const delta = clock.getDelta();
            const time = clock.getElapsedTime();

            const posAttr = sparks.geometry.attributes.position;
            for(let i=0; i<sparkCount; i++) {
                const py = posAttr.getY(i);
                if(py > -50) {
                    posAttr.setX(i, posAttr.getX(i) + sparkVel[i].x * delta);
                    posAttr.setY(i, py + sparkVel[i].y * delta);
                    posAttr.setZ(i, posAttr.getZ(i) + sparkVel[i].z * delta);
                    sparkVel[i].y -= 20 * delta;
                    if(py < 0) posAttr.setY(i, -100);
                }
            }
            posAttr.needsUpdate = true;

            for(let i=scanningRings.length-1; i>=0; i--) {
                const r = scanningRings[i];
                r.scale.addScalar(5 * delta);
                r.material.opacity -= 0.5 * delta;
                if(r.material.opacity <= 0) {
                    scene.remove(r);
                    scanningRings.splice(i, 1);
                }
            }

            if (isAlarm) {
                ledLight.intensity = (Math.sin(time * 20) * 0.5 + 0.5) * 8;
                camera.position.x += (Math.random()-0.5)*0.1;
                camera.position.z += (Math.random()-0.5)*0.1;
            }

            renderer.render(scene, camera);
        }
        animate();

        // Resize
        window.addEventListener('resize', () => {
            const w = container.clientWidth;
            const h = container.clientHeight;
            renderer.setSize(w, h);
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
        });
    }
</script>
