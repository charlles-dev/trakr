---
---

<section class="hero container">
  <div class="hero-content">
    <div class="badge animate-fade-in">100% OFFLINE-FIRST</div>
    <h1 class="animate-fade-in delay-100">
      The Autonomous <span class="text-orange">Smart Toolbox</span>
    </h1>
    <p class="animate-fade-in delay-200">
      Um ecossistema open-source de hardware e software para rastreamento e gestão de ferramentas em ambientes extremos. Sem nuvem. Sem atrasos. Controle total na borda.
    </p>
    <div class="cta-group animate-fade-in delay-300">
      <a href="https://github.com/charl/trakr" target="_blank" class="btn-primary">Explorar Projeto</a>
      <a href="#features" class="btn-secondary">Descobrir Features</a>
    </div>
  </div>
  
  <div class="hero-visual animate-fade-in delay-400">
    <div class="glow-orb"></div>
    <div class="hardware-mockup">
      <!-- Placeholder for the hardware/suitcase visual -->
      <div class="led-indicator"></div>
      <div class="esp-chip">ESP32 CORE</div>
      <div class="rfid-waves">
        <span></span><span></span><span></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 100vh;
    padding-top: 4rem;
  }

  .hero-content {
    flex: 1;
    max-width: 600px;
    opacity: 0; /* Base for animation */
  }

  .badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(255, 140, 0, 0.1);
    color: var(--color-orange);
    border: 1px solid var(--color-orange);
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 2px;
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 4.5rem;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: #fff;
  }

  p {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }

  .cta-group {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .btn-secondary {
    color: var(--color-text);
    font-weight: 600;
    position: relative;
    padding: 0.5rem 0;
  }
  
  .btn-secondary::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-green);
    transition: width 0.3s ease;
  }

  .btn-secondary:hover::after {
    width: 100%;
  }

  .hero-visual {
    flex: 1;
    display: flex;
    justify-content: center;
    position: relative;
    opacity: 0;
  }

  .glow-orb {
    position: absolute;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(255,140,0,0.15) 0%, rgba(10,14,39,0) 70%);
    z-index: 0;
  }

  .hardware-mockup {
    position: relative;
    z-index: 1;
    width: 350px;
    height: 350px;
    background: rgba(58, 95, 79, 0.1);
    border: 2px solid var(--color-green);
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 50px rgba(58, 95, 79, 0.2);
    transform: perspective(1000px) rotateY(-15deg) rotateX(10deg);
    transition: transform 0.5s ease;
  }

  .hardware-mockup:hover {
    transform: perspective(1000px) rotateY(0deg) rotateX(0deg);
  }

  .led-indicator {
    width: 12px;
    height: 12px;
    background: var(--color-orange);
    border-radius: 50%;
    position: absolute;
    top: 20px;
    right: 20px;
    box-shadow: 0 0 15px var(--color-orange), 0 0 30px var(--color-orange);
    animation: pulseLed 2s infinite;
  }

  .esp-chip {
    padding: 1rem 2rem;
    background: #111;
    border: 1px solid #333;
    border-radius: 8px;
    font-family: monospace;
    color: #fff;
    margin-bottom: 2rem;
  }

  .rfid-waves {
    display: flex;
    gap: 8px;
  }

  .rfid-waves span {
    display: block;
    width: 4px;
    height: 20px;
    background: var(--color-green);
    border-radius: 2px;
    animation: wave 1s infinite alternate;
  }

  .rfid-waves span:nth-child(2) { animation-delay: 0.2s; }
  .rfid-waves span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes pulseLed {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @keyframes wave {
    from { height: 10px; opacity: 0.5; }
    to { height: 30px; opacity: 1; }
  }

  @media (max-width: 968px) {
    .hero {
      flex-direction: column;
      text-align: center;
      padding-top: 8rem;
      gap: 4rem;
    }

    h1 {
      font-size: 3rem;
    }

    .cta-group {
      justify-content: center;
    }
  }
</style>
