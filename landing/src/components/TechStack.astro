---
---

<section class="container">
  <div class="glass-card tech-stack-container animate-fade-in delay-200">
    <div class="stack-header">
      <h2>Arquitetura 100% Offline</h2>
      <p>Desenvolvido com o que há de melhor em IoT Edge Computing e Mobile Nativo.</p>
    </div>

    <div class="stack-visual">
      
      <!-- Hardware Layer -->
      <div class="stack-layer layer-hardware">
        <div class="layer-title">Edge Hardware</div>
        <div class="layer-items">
          <div class="tech-pill">ESP32-WROOM-32</div>
          <div class="tech-pill">LittleFS (Flash)</div>
          <div class="tech-pill">YRM100 UHF RFID</div>
          <div class="tech-pill">PlatformIO (C++)</div>
        </div>
      </div>

      <!-- Connector -->
      <div class="stack-connector">
        <div class="line"></div>
        <div class="protocol-badge">BLE GATT Protocol</div>
        <div class="line"></div>
      </div>

      <!-- Mobile Layer -->
      <div class="stack-layer layer-mobile">
        <div class="layer-title">Mobile Thin Client</div>
        <div class="layer-items">
          <div class="tech-pill">Kotlin Nativo</div>
          <div class="tech-pill">Jetpack Compose</div>
          <div class="tech-pill">Room (SQLite)</div>
          <div class="tech-pill">BLE Foreground Service</div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .tech-stack-container {
    padding: 4rem;
    margin-top: 2rem;
    position: relative;
    overflow: hidden;
  }

  .tech-stack-container::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(58, 95, 79, 0.05) 0%, transparent 70%);
    animation: rotate 20s linear infinite;
    z-index: 0;
    pointer-events: none;
  }

  .stack-header {
    text-align: center;
    position: relative;
    z-index: 1;
    margin-bottom: 4rem;
  }

  h2 {
    font-size: 2.5rem;
    color: #fff;
    margin-bottom: 0.5rem;
  }

  p {
    color: var(--color-text-muted);
  }

  .stack-visual {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .stack-layer {
    width: 100%;
    max-width: 800px;
    background: rgba(10, 14, 39, 0.5);
    border: 1px solid var(--color-green);
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.5);
  }

  .layer-hardware {
    border-color: var(--color-orange);
  }

  .layer-title {
    font-size: 1.25rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 1.5rem;
    color: #fff;
  }

  .layer-hardware .layer-title {
    color: var(--color-orange);
  }

  .layer-mobile .layer-title {
    color: var(--color-green);
  }

  .layer-items {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .tech-pill {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.5rem 1rem;
    border-radius: 30px;
    font-size: 0.9rem;
    color: #E0E4F5;
    transition: all 0.3s ease;
  }

  .tech-pill:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  .stack-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100px;
  }

  .line {
    width: 2px;
    height: 40px;
    background: linear-gradient(to bottom, var(--color-orange), var(--color-green));
    position: relative;
    overflow: hidden;
  }

  .line::after {
    content: '';
    position: absolute;
    top: -50%;
    left: 0;
    width: 100%;
    height: 50%;
    background: #fff;
    box-shadow: 0 0 10px #fff;
    animation: flowData 2s linear infinite;
  }

  .protocol-badge {
    background: #111;
    border: 1px solid #333;
    padding: 0.25rem 1rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-family: monospace;
    color: var(--color-text-muted);
    z-index: 2;
  }

  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes flowData {
    0% { top: -50%; opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }

  @media (max-width: 768px) {
    .tech-stack-container {
      padding: 2rem;
    }
  }
</style>
