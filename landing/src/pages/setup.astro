---
// Assistente de configuração do hardware Trakr
---
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trakr | Configuração do hardware</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js" is:inline></script>

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <script is:inline>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#20B898',
                        dark: '#0B1210',
                        panel: '#111111'
                    },
                    fontFamily: {
                        sans: ['Satoshi', 'Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>
    
    <!-- ESP Web Tools -->
    <script type="module" src="https://unpkg.com/esp-web-tools@8.0.1/dist/web/install-button.js?module" is:inline></script>

    <style is:inline>
        @font-face {
            font-family: 'Satoshi';
            src: url('https://vgbujcuwptvheqijyjbe.supabase.co/storage/v1/object/public/hmac-uploads/uploads/4aed2f49-a476-436f-bae8-f31aa18f46fa/1767920861040-60c1c779/Satoshi-Variable.woff2') format('woff2');
            font-weight: 300 900;
            font-display: swap;
            font-style: normal;
        }

        body {
            background-color: #0B1210;
            color: #e0e0e0;
            overflow-x: hidden;
            font-family: 'Satoshi', 'Inter', sans-serif;
        }

        ::selection {
            background-color: #20B898;
            color: white;
            text-shadow: 0 0 8px rgba(32, 184, 152, 0.8);
        }

        /* Basic Animations */
        .step-content {
            display: none;
            opacity: 0;
            transform: translateY(20px);
        }
        .step-content.active {
            display: block;
            animation: sweep 0.6s cubic-bezier(0.19, 1, 0.22, 1) forwards;
        }
        @keyframes sweep {
            to { opacity: 1; transform: translateY(0); }
        }

        /* Radio Card Selection */
        .radio-card input:checked + div {
            border-color: #20B898 !important;
            background: rgba(32, 184, 152, 0.05);
            box-shadow: inset 0 0 30px rgba(32, 184, 152, 0.1);
        }
        .radio-card input:checked + div .check-icon {
            opacity: 1;
            transform: scale(1);
        }

        /* Toggle Selection */
        .toggle-switch input:checked + div {
            border-color: #20B898;
            background: rgba(32, 184, 152, 0.05);
        }
        .toggle-switch input:checked + div .toggle-bg {
            background-color: #20B898;
            border-color: #20B898;
        }
        .toggle-switch input:checked + div .toggle-circle {
            transform: translateX(1.5rem);
        }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #0B1210; }
        ::-webkit-scrollbar-thumb { background: #20B898; border-radius: 10px; }

        /* Typography */
        .var-weight { font-weight: 800; letter-spacing: -0.05em; }
    </style>
</head>
<body class="antialiased min-h-screen flex flex-col relative">

    <!-- Background Engine -->
    <div class="fixed inset-0 z-[-1] pointer-events-none overflow-hidden bg-[#0B1210]">
        <!-- Gradient blobs -->
        <div class="absolute top-[-10vw] left-[-10vw] w-[60vw] h-[60vw] bg-[#20B898] rounded-full blur-[120px] opacity-20"></div>
        <div class="absolute bottom-[-10vw] right-[-10vw] w-[60vw] h-[60vw] bg-[#4a5568] rounded-full blur-[120px] opacity-20"></div>
        
        <!-- Blueprint grid -->
        <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 50px 50px; transform: perspective(1000px) rotateX(60deg) rotateZ(45deg) scale(2);"></div>
        
        <!-- TV Noise -->
        <div class="absolute inset-0 mix-blend-overlay opacity-5" style="background-image: url('data:image/svg+xml;utf8,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>
    </div>
    
    <!-- Top Nav -->
    <nav class="fixed top-0 left-0 right-0 z-[100] px-6 py-6 flex items-center justify-between border-b border-white/10 bg-[#111]/80 backdrop-blur-md">
        <div class="max-w-7xl mx-auto w-full flex items-center justify-between">
            <a href="/" class="flex items-center group">
                <img src="/logo.svg" alt="Trakr" class="w-10 h-10 transition-transform duration-500 group-hover:rotate-12">
                <span class="ml-3 text-lg font-bold tracking-tighter">TRAKR</span>
            </a>
            <div class="font-mono text-[10px] text-[#888] tracking-[0.3em] hidden md:block uppercase font-bold border border-[#333] px-4 py-2 rounded-full bg-[#111]">
                Instalador_do_Sistema // V1.0
            </div>
            <a href="/" class="text-sm font-bold text-[#888] hover:text-white transition-colors">
                CANCELAR
            </a>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-1 w-full max-w-5xl mx-auto px-6 pt-32 pb-12 flex flex-col relative z-20">
        
        <!-- Header -->
        <div class="mb-16">
            <h1 class="text-5xl md:text-7xl font-bold mb-4 var-weight text-white">Configuração <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#20B898] to-orange-400">do hardware</span></h1>
            <p class="text-[#888] font-mono text-sm max-w-2xl leading-relaxed">
                Configure as especificações do seu nó Trakr. O sistema vai compilar um firmware personalizado conforme o seu hardware.
            </p>
        </div>

        <!-- Progress Bar -->
        <div class="mb-12">
            <div class="flex justify-between mb-4">
                <span class="font-mono text-[10px] font-bold tracking-[0.2em] text-[#20B898]" id="step-indicator">ETAPA 1 DE 5</span>
                <span class="font-mono text-[10px] font-bold tracking-[0.2em] text-[#888]" id="step-title-indicator">MICROCONTROLADOR</span>
            </div>
            <div class="w-full h-1 bg-[#222] rounded-full overflow-hidden relative">
                <div id="progress-bar" class="absolute top-0 left-0 h-full bg-[#20B898] w-1/5 transition-all duration-700 shadow-[0_0_15px_#20B898]"></div>
            </div>
        </div>

        <!-- WIZARD FORM -->
        <form id="setup-form" class="flex-1 flex flex-col relative min-h-[400px]">
            
            <!-- STEP 1: Antenna -->
            <div class="step-content active" id="step-1">
                <h2 class="text-3xl font-bold mb-8 flex items-center gap-3 text-white tracking-tight">
                    <iconify-icon icon="lucide:radio-tower" class="text-[#20B898]"></iconify-icon> Antena
                </h2>
                <p class="text-[#888] text-sm mb-8 -mt-4">Escolha qual antena UHF vai equipar o seu nó. O leitor base é o YRM100 em todos os casos.</p>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <label class="radio-card cursor-pointer group flex flex-col h-full w-full relative">
                        <input type="radio" name="antenna" value="interna" class="hidden" checked>
                        <div class="bg-[#080808] border border-[#222] rounded-3xl p-8 flex flex-col h-full w-full transition-all duration-300 group-hover:border-[#444] group-hover:-translate-y-1 overflow-hidden relative">
                            <iconify-icon icon="lucide:check-circle-2" class="check-icon absolute top-6 right-6 text-[#20B898] text-2xl opacity-0 transform scale-50 transition-all duration-300 z-10"></iconify-icon>
                            <div class="w-14 h-14 bg-[#111] border border-[#333] rounded-xl mb-6 flex items-center justify-center transition-colors group-hover:border-[#20B898]/50 shrink-0 relative z-10">
                                <iconify-icon icon="lucide:radio" class="text-3xl text-white"></iconify-icon>
                            </div>
                            <h3 class="font-bold text-2xl mb-2 text-white relative z-10">Antena integrada</h3>
                            <p class="text-[10px] text-[#20B898] font-mono tracking-widest uppercase mb-4 font-bold relative z-10">PADRÃO — NATIVA</p>
                            <p class="text-sm text-[#888] leading-relaxed flex-1 relative z-10">PCB UHF integrada ao módulo YRM100. Melhor equilíbrio entre consumo e alcance para uso diário.</p>
                            <div class="mt-6 pt-4 border-t border-[#333] flex justify-between font-mono text-[10px] text-[#666] uppercase font-bold relative z-10">
                                <span>ALCANCE: ~1.5m</span>
                                <span>0 dBi</span>
                            </div>
                        </div>
                    </label>

                    <label class="radio-card cursor-pointer group flex flex-col h-full w-full relative">
                        <input type="radio" name="antenna" value="dip2" class="hidden">
                        <div class="bg-[#080808] border border-[#222] rounded-3xl p-8 flex flex-col h-full w-full transition-all duration-300 group-hover:border-[#444] group-hover:-translate-y-1 overflow-hidden relative">
                            <iconify-icon icon="lucide:check-circle-2" class="check-icon absolute top-6 right-6 text-[#20B898] text-2xl opacity-0 transform scale-50 transition-all duration-300 z-10"></iconify-icon>
                            <div class="w-14 h-14 bg-[#111] border border-[#333] rounded-xl mb-6 flex items-center justify-center transition-colors group-hover:border-[#20B898]/50 shrink-0 relative z-10">
                                <iconify-icon icon="lucide:antenna" class="text-3xl text-white"></iconify-icon>
                            </div>
                            <h3 class="font-bold text-2xl mb-2 text-white relative z-10">Dipolo flexível</h3>
                            <p class="text-[10px] text-[#20B898] font-mono tracking-widest uppercase mb-4 font-bold relative z-10">2 DBI — U.FL</p>
                            <p class="text-sm text-[#888] leading-relaxed flex-1 relative z-10">UHF RFID 865–928 MHz, 50Ω, polarização linear. Leve e fácil de posicionar na carcaça.</p>
                            <div class="mt-6 pt-4 border-t border-[#333] flex justify-between font-mono text-[10px] text-[#666] uppercase font-bold relative z-10">
                                <span>ALCANCE: ~1.5–2m</span>
                                <span>U.FL/IPEX</span>
                            </div>
                        </div>
                    </label>

                    <label class="radio-card cursor-pointer group flex flex-col h-full w-full relative">
                        <input type="radio" name="antenna" value="patch3" class="hidden">
                        <div class="bg-[#080808] border border-[#222] rounded-3xl p-8 flex flex-col h-full w-full transition-all duration-300 group-hover:border-[#444] group-hover:-translate-y-1 overflow-hidden relative">
                            <iconify-icon icon="lucide:check-circle-2" class="check-icon absolute top-6 right-6 text-[#20B898] text-2xl opacity-0 transform scale-50 transition-all duration-300 z-10"></iconify-icon>
                            <div class="w-14 h-14 bg-[#111] border border-[#333] rounded-xl mb-6 flex items-center justify-center transition-colors group-hover:border-[#20B898]/50 shrink-0 relative z-10">
                                <iconify-icon icon="lucide:square-dashed-bottom" class="text-3xl text-white"></iconify-icon>
                            </div>
                            <h3 class="font-bold text-2xl mb-2 text-white relative z-10">Patch cerâmica</h3>
                            <p class="text-[10px] text-[#20B898] font-mono tracking-widest uppercase mb-4 font-bold relative z-10">3 DBI — U.FL</p>
                            <p class="text-sm text-[#888] leading-relaxed flex-1 relative z-10">UHF RFID 865–928 MHz, 50Ω, polarização linear. Compacta — cabe dentro da carcaça.</p>
                            <div class="mt-6 pt-4 border-t border-[#333] flex justify-between font-mono text-[10px] text-[#666] uppercase font-bold relative z-10">
                                <span>ALCANCE: ~2–3m</span>
                                <span>U.FL/IPEX</span>
                            </div>
                        </div>
                    </label>

                    <label class="radio-card cursor-pointer group flex flex-col h-full w-full relative">
                        <input type="radio" name="antenna" value="panel45" class="hidden">
                        <div class="bg-[#080808] border border-[#222] rounded-3xl p-8 flex flex-col h-full w-full transition-all duration-300 group-hover:border-[#444] group-hover:-translate-y-1 overflow-hidden relative">
                            <iconify-icon icon="lucide:check-circle-2" class="check-icon absolute top-6 right-6 text-[#20B898] text-2xl opacity-0 transform scale-50 transition-all duration-300 z-10"></iconify-icon>
                            <div class="w-14 h-14 bg-[#111] border border-[#333] rounded-xl mb-6 flex items-center justify-center transition-colors group-hover:border-[#20B898]/50 shrink-0 relative z-10">
                                <iconify-icon icon="lucide:satellite-dish" class="text-3xl text-white"></iconify-icon>
                            </div>
                            <h3 class="font-bold text-2xl mb-2 text-white relative z-10">Painel 4.5 dBi</h3>
                            <p class="text-[10px] text-[#20B898] font-mono tracking-widest uppercase mb-4 font-bold relative z-10">4.5 DBI — SMA</p>
                            <p class="text-sm text-[#888] leading-relaxed flex-1 relative z-10">UHF RFID 865–928 MHz, 50Ω, polarização linear. Boa escolha para o modo estação fixo.</p>
                            <div class="mt-6 pt-4 border-t border-[#333] flex justify-between font-mono text-[10px] text-[#666] uppercase font-bold relative z-10">
                                <span>ALCANCE: ~4–5m</span>
                                <span>SMA + PIGTAIL U.FL</span>
                            </div>
                        </div>
                    </label>

                    <label class="radio-card cursor-pointer group flex flex-col h-full w-full relative">
                        <input type="radio" name="antenna" value="circ6" class="hidden">
                        <div class="bg-[#080808] border border-[#222] rounded-3xl p-8 flex flex-col h-full w-full transition-all duration-300 group-hover:border-[#444] group-hover:-translate-y-1 overflow-hidden relative">
                            <iconify-icon icon="lucide:check-circle-2" class="check-icon absolute top-6 right-6 text-[#20B898] text-2xl opacity-0 transform scale-50 transition-all duration-300 z-10"></iconify-icon>
                            <div class="w-14 h-14 bg-[#111] border border-[#333] rounded-xl mb-6 flex items-center justify-center transition-colors group-hover:border-[#20B898]/50 shrink-0 relative z-10">
                                <iconify-icon icon="lucide:orbit" class="text-3xl text-white"></iconify-icon>
                            </div>
                            <h3 class="font-bold text-2xl mb-2 text-white relative z-10">Patch circular 6 dBi</h3>
                            <p class="text-[10px] text-[#20B898] font-mono tracking-widest uppercase mb-4 font-bold relative z-10">6 DBI — SMA</p>
                            <p class="text-sm text-[#888] leading-relaxed flex-1 relative z-10">UHF RFID 865–928 MHz, 50Ω, polarização circular — lê tags em qualquer orientação.</p>
                            <div class="mt-6 pt-4 border-t border-[#333] flex justify-between font-mono text-[10px] text-[#666] uppercase font-bold relative z-10">
                                <span>ALCANCE: ~6–8m</span>
                                <span>SMA + PIGTAIL U.FL</span>
                            </div>
                        </div>
                    </label>

                    <label class="radio-card cursor-pointer group flex flex-col h-full w-full relative">
                        <input type="radio" name="antenna" value="panel8" class="hidden">
                        <div class="bg-[#080808] border border-[#222] rounded-3xl p-8 flex flex-col h-full w-full transition-all duration-300 group-hover:border-[#444] group-hover:-translate-y-1 overflow-hidden relative">
                            <iconify-icon icon="lucide:check-circle-2" class="check-icon absolute top-6 right-6 text-[#20B898] text-2xl opacity-0 transform scale-50 transition-all duration-300 z-10"></iconify-icon>
                            <div class="w-14 h-14 bg-[#111] border border-[#333] rounded-xl mb-6 flex items-center justify-center transition-colors group-hover:border-[#20B898]/50 shrink-0 relative z-10">
                                <iconify-icon icon="lucide:radio-tower" class="text-3xl text-white"></iconify-icon>
                            </div>
                            <h3 class="font-bold text-2xl mb-2 text-white relative z-10">Painel 8 dBi</h3>
                            <p class="text-[10px] text-[#20B898] font-mono tracking-widest uppercase mb-4 font-bold relative z-10">8 DBI — SMA</p>
                            <p class="text-sm text-[#888] leading-relaxed flex-1 relative z-10">UHF RFID 865–928 MHz, feixe estreito. Alcance máximo, ideal para uso fixo (estação).</p>
                            <div class="mt-6 pt-4 border-t border-[#333] flex justify-between font-mono text-[10px] text-[#666] uppercase font-bold relative z-10">
                                <span>ALCANCE: ~8–10m</span>
                                <span>SMA + PIGTAIL U.FL</span>
                            </div>
                        </div>
                    </label>
                </div>

                <p class="mt-6 text-[10px] font-mono text-[#666] leading-relaxed border border-[#222] bg-[#080808] rounded-xl p-4">
                    COMPATIBILIDADE: todas as antenas são UHF RFID na banda 865–928 MHz (ETSI/FCC), impedância 50Ω e conectam no conector U.FL/IPEX do YRM100 — as variantes SMA acompanham pigtail U.FL→SMA. Alcances estimados com TX 26 dBm em campo aberto.
                </p>
            </div>

            <!-- STEP 2: Hardware Add-ons -->
            <div class="step-content" id="step-2">
                <h2 class="text-3xl font-bold mb-8 flex items-center gap-3 text-white tracking-tight">
                    <iconify-icon icon="lucide:blocks" class="text-[#20B898]"></iconify-icon> Addons de hardware
                    <span id="hw-count" class="ml-auto text-xs font-mono text-[#20B898] bg-[#20B898]/10 border border-[#20B898]/20 px-3 py-1 rounded-full">3 selecionados</span>
                </h2>
                
                <p class="text-[#888] text-sm mb-8 -mt-4">Selecione os módulos que você vai instalar. O produto base (LED, buzzer, radar, registro, deep sleep, OTA, relógio) já vem incluso; os addons abaixo são opcionais e entram no build como flags <span class="font-mono text-[#20B898]">TRAKR_HAS_*</span> quando implementados.</p>

                <div id="hw-addons-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6"></div>
            </div>

            <!-- STEP 3: Software Add-ons -->
            <div class="step-content" id="step-3">
                <h2 class="text-3xl font-bold mb-8 flex items-center gap-3 text-white tracking-tight">
                    <iconify-icon icon="lucide:code-2" class="text-[#20B898]"></iconify-icon> Addons de software
                    <span id="sw-count" class="ml-auto text-xs font-mono text-[#20B898] bg-[#20B898]/10 border border-[#20B898]/20 px-3 py-1 rounded-full">4 selecionados</span>
                </h2>

                <p class="text-[#888] text-sm mb-8 -mt-4">Features do firmware e do app. Alguns dependem de hardware do passo anterior — avisamos se faltar o módulo.</p>

                <div id="sw-addons-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6"></div>
            </div>

            <!-- STEP 4: Installation -->
            <div class="step-content" id="step-4">
                <h2 class="text-3xl font-bold mb-8 flex items-center gap-3 text-white tracking-tight">
                    <iconify-icon icon="lucide:terminal" class="text-[#20B898]"></iconify-icon> Firmware
                </h2>
                
                <div class="bg-[#080808] border border-[#222] rounded-3xl p-8 mb-8 relative overflow-hidden">
                    <div class="flex items-center justify-between mb-6 relative z-10">
                        <h3 class="font-mono text-xs font-bold tracking-[0.2em] uppercase text-[#666]">Resumo do build</h3>
                        <span class="px-3 py-1 bg-[#20B898]/10 text-[#20B898] font-mono text-[10px] font-bold rounded border border-[#20B898]/30 uppercase tracking-widest">Pronto</span>
                    </div>
                    
                    <div class="font-mono text-xs md:text-sm bg-[#0B1210] p-6 rounded-xl border border-[#222] text-[#888] mb-8 relative overflow-hidden z-10">
                        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#20B898]/5 to-transparent pointer-events-none"></div>
                        <div class="relative z-10 space-y-2">
                            <div>> TARGET: ESP32 <span class="text-[#666]">(fixo — firmware atual)</span></div>
                            <div>> BASE: LED · BUZZER · RADAR · REGISTRO · DEEP_SLEEP · OTA · RELÓGIO <span class="text-[#666]">(fixo — nativo)</span></div>
                            <div>> ANTENNA: <span id="sum-antenna" class="text-[#20B898] font-bold">INTERNA</span></div>
                            <div>> HW_ADDONS: <span id="sum-periph" class="text-[#20B898] font-bold">NONE</span></div>
                            <div>> SW_ADDONS: <span id="sum-sw" class="text-[#20B898] font-bold">NONE</span></div>
                            <div>> BUILD_FLAGS: <span id="sum-flags" class="text-[#20B898] font-bold">-DNONE</span></div>
                            <div id="sum-warnings" class="text-[#EAB308] mt-2 hidden"></div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative z-10">
                        
                        <!-- Manual Download -->
                        <button type="button" id="btn-download-bin" class="flex flex-col items-center justify-center gap-4 p-8 rounded-2xl border border-[#333] bg-[#0a0a0a] hover:bg-[#111] transition-all hover:border-[#20B898]/50 group relative overflow-hidden h-full">
                            <iconify-icon icon="lucide:download-cloud" class="text-4xl text-[#666] group-hover:text-white transition-colors relative z-10"></iconify-icon>
                            <div class="text-center relative z-10">
                                <h4 class="font-bold text-white text-lg">Baixar .bin</h4>
                                <p class="text-[10px] text-[#888] font-mono mt-2 tracking-widest uppercase">Gravação manual via esptool.py</p>
                            </div>
                        </button>

                        <!-- Web Serial Flash -->
                        <div class="flex flex-col items-center justify-center gap-4 p-8 rounded-2xl border border-[#20B898] bg-[#20B898]/5 hover:bg-[#20B898]/10 transition-all group relative overflow-hidden h-full">
                            <iconify-icon icon="lucide:usb" class="text-4xl text-[#20B898] relative z-10"></iconify-icon>
                            <div class="text-center z-10 w-full flex flex-col items-center">
                                <h4 class="font-bold text-[#20B898] text-lg">Instalação via Web Serial</h4>
                                <p class="text-[10px] text-[#888] font-mono mt-2 mb-6 tracking-widest uppercase">Grave direto via cabo USB</p>
                                
                                <esp-web-install-button manifest="/firmware/manifest.json">
                                    <button slot="activate" id="btn-web-serial" class="bg-[#20B898] hover:bg-white text-black px-8 py-3 rounded-lg font-mono text-[10px] font-bold uppercase tracking-[0.2em] transition-colors shadow-[0_0_15px_rgba(32,184,152,0.4)]">
                                        Conectar USB
                                    </button>
                                    <span slot="unsupported" class="text-red-400 font-mono text-[10px] text-center block uppercase tracking-widest">
                                        Navegador não suportado.<br>Use Chrome/Edge no desktop.
                                    </span>
                                    <span slot="not-allowed" class="text-red-400 font-mono text-[10px] text-center block uppercase tracking-widest">
                                        HTTPS é necessário para Web Serial.
                                    </span>
                                </esp-web-install-button>
                            </div>
                        </div>
                    </div>

                    <!-- Config JSON Download -->
