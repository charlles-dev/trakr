    <!-- Wizard Controller Script -->
    <script is:inline>
        const steps = 5;
        let currentStep = 1;

        const stepTitles = [
            "ANTENA",
            "ADDONS DE HARDWARE",
            "ADDONS DE SOFTWARE",
            "FIRMWARE",
            "APP ANDROID"
        ];

        const btnNext = document.getElementById('btn-next');
        const btnPrev = document.getElementById('btn-prev');
        const progressBar = document.getElementById('progress-bar');
        const stepIndicator = document.getElementById('step-indicator');
        const stepTitle = document.getElementById('step-title-indicator');

        const BADGES = {
            NATIVO: 'text-[#20B898] bg-[#20B898]/10 border-[#20B898]/20',
            ROADMAP: 'text-[#EAB308] bg-[#EAB308]/10 border-[#EAB308]/20',
            EXPERIMENTAL: 'text-[#E879F9] bg-[#E879F9]/10 border-[#E879F9]/20'
        };

        const HW_ADDONS = [
            { v: 'oled', name: 'OLED SSD1306 0.96"', badge: 'ROADMAP', icon: 'lucide:monitor', desc: 'Status sem app (contagem, bateria, RSSI)', flag: 'TRAKR_HAS_OLED', group: 'HMI e feedback' },
            { v: 'btn2', name: 'Botão físico secundário', badge: 'ROADMAP', icon: 'lucide:circle-dot', desc: 'Alternar modo radar sem o app', flag: 'TRAKR_HAS_BTN2', group: 'HMI e feedback' },
            { v: 'batt', name: 'Monitor de bateria (INA219)', badge: 'ROADMAP', icon: 'lucide:battery-charging', desc: '% de carga no app e no dispositivo', flag: 'TRAKR_HAS_INA219', group: 'Energia e bateria' },
            { v: 'batt18650', name: 'Bateria 18650 troca rápida', badge: 'ROADMAP', icon: 'lucide:battery', desc: 'Suporte com trava, sem solda', flag: 'TRAKR_HAS_18650', group: 'Energia e bateria' },
            { v: 'vib', name: 'Motor vibrador', badge: 'ROADMAP', icon: 'lucide:vibrate', desc: 'Alerta silencioso (rastreador na mão)', flag: 'TRAKR_HAS_VIBRATOR', group: 'Segurança' },
            { v: 'bme280', name: 'BME280', badge: 'ROADMAP', icon: 'lucide:thermometer', desc: 'Temp/umidade/pressão + alerta de exposição', flag: 'TRAKR_HAS_BME280', group: 'Sensores e contexto' },
            { v: 'imu', name: 'IMU (MPU6050)', badge: 'ROADMAP', icon: 'lucide:move-3d', desc: 'Wake por gesto/movimento', flag: 'TRAKR_HAS_MPU6050', group: 'Sensores e contexto' },
            { v: 'snapfit', name: 'Encaixe snap-fit', badge: 'ROADMAP', icon: 'lucide:package', desc: 'Carcaça sem ferramenta', flag: null, group: 'Mecânica e carcaça' },
            { v: 'ip54', name: 'Vedações IP54', badge: 'ROADMAP', icon: 'lucide:shield', desc: 'Proteção contra poeira e respingo', flag: null, group: 'Mecânica e carcaça' },
            { v: 'bumpers', name: 'Bumpers TPU', badge: 'ROADMAP', icon: 'lucide:footprints', desc: 'Antiderrapante e estabilidade', flag: null, group: 'Mecânica e carcaça' },
            { v: 'screws', name: 'Parafusos captivos', badge: 'ROADMAP', icon: 'lucide:screwdriver', desc: 'Fixos na carcaça para não se perderem', flag: null, group: 'Mecânica e carcaça' },
            { v: 'qr', name: 'QR de montagem', badge: 'ROADMAP', icon: 'lucide:qr-code', desc: 'Aponta para a documentação de montagem', flag: null, group: 'Mecânica e carcaça' }
        ];

        const SW_ADDONS = [
            { v: 'txpow', name: 'Potência TX configurável', badge: 'ROADMAP', icon: 'lucide:radio-tower', desc: 'dBm por cenário (prédio x canteiro)', flag: null, group: 'RF e alcance' },
            { v: 'live', name: 'Varredura ao vivo', badge: 'ROADMAP', icon: 'lucide:activity', desc: 'Streaming EPC + RSSI via GATT', flag: null, group: 'RF e alcance' },
            { v: 'rssical', name: 'Calibração de RSSI', badge: 'ROADMAP', icon: 'lucide:sliders-horizontal', desc: 'Offset dBm por ambiente (campo, galpão)', flag: null, group: 'RF e alcance' },
            { v: 'direction', name: 'Direção por passo', badge: 'ROADMAP', icon: 'lucide:move-right', desc: '"+3 dBm no último passo → continue"', flag: null, group: 'Localização e navegação' },
            { v: 'findme', name: 'Achar meu dispositivo', badge: 'ROADMAP', icon: 'lucide:crosshair', desc: 'RSSI do celular guia até o rastreador', flag: null, group: 'Localização e navegação' },
            { v: 'nfc_pair', name: 'Pareamento por aproximação', badge: 'ROADMAP', icon: 'lucide:contact-round', desc: 'Tag NFC passiva no rastreador — o celular lê', flag: null, group: 'Segurança e acesso' },
            { v: 'exposure', name: 'Alerta de exposição', badge: 'ROADMAP', icon: 'lucide:flame', desc: 'Calor/umidade das ferramentas', flag: null, dep: 'bme280', group: 'Sensores e contexto' },
            { v: 'gesture', name: 'Wake por movimento', badge: 'ROADMAP', icon: 'lucide:hand', desc: 'Pegar o rastreador já dispara a varredura', flag: null, dep: 'imu', group: 'Sensores e contexto' },
            { v: 'sounds', name: 'Padrões sonoros por evento', badge: 'ROADMAP', icon: 'lucide:music', desc: 'Som/vibração por tipo de alerta', flag: null, group: 'HMI e feedback' },
            { v: 'diag', name: 'Inspeção de add-ons', badge: 'ROADMAP', icon: 'lucide:stethoscope', desc: 'Diagnóstico dos módulos detectados', flag: null, group: 'App e UX' },
            { v: 'rssith', name: 'Limiares de RSSI', badge: 'ROADMAP', icon: 'lucide:gauge', desc: 'Ajuste fino do alerta por tag', flag: null, group: 'App e UX' },
            { v: 'alerts', name: 'Alertas configuráveis', badge: 'ROADMAP', icon: 'lucide:bell', desc: 'Silenciar por rastreador', flag: null, group: 'App e UX' },
            { v: 'stats', name: 'Estatísticas locais', badge: 'ROADMAP', icon: 'lucide:bar-chart-3', desc: 'Ferramentas mais esquecidas, frequência', flag: null, group: 'App e UX' },
            { v: 'backup', name: 'Backup/restore local', badge: 'ROADMAP', icon: 'lucide:archive', desc: 'Export/import JSON único', flag: null, group: 'App e UX' }
        ];

        function addonCard(a, inputName) {
            const badge = BADGES[a.badge] || BADGES.ROADMAP;
            const checked = a.def ? ' checked' : '';
            return `<label class="toggle-switch cursor-pointer group flex items-center justify-between w-full relative">
                        <input type="checkbox" name="${inputName}" value="${a.v}" class="hidden"${checked}>
                        <div class="bg-[#080808] border border-[#222] rounded-2xl p-6 flex items-center justify-between w-full transition-all duration-300 group-hover:border-[#444] relative overflow-hidden">
                            <div class="flex items-center gap-5 relative z-10">
                                <div class="w-12 h-12 bg-[#111] border border-[#333] rounded-xl flex items-center justify-center">
                                    <iconify-icon icon="${a.icon}" class="text-[#888] text-xl group-hover:text-[#20B898] transition-colors"></iconify-icon>
                                </div>
                                <div>
                                    <h3 class="font-bold text-lg text-white">${a.name} <span class="ml-2 text-[8px] font-mono ${badge} border px-1.5 py-0.5 rounded align-middle">${a.badge}</span></h3>
                                    <p class="text-[10px] text-[#888] font-mono uppercase tracking-widest">${a.desc}</p>
                                </div>
                            </div>
                            <div class="toggle-bg w-12 h-6 bg-[#222] rounded-full relative transition-colors border border-[#333] z-10">
                                <div class="toggle-circle w-5 h-5 bg-white rounded-full absolute top-[1px] left-[1px] transition-transform shadow"></div>
                            </div>
                        </div>
                    </label>`;
        }

        function renderAddons(containerId, list, inputName) {
            const container = document.getElementById(containerId);
            if (!container) return;
            let html = '';
            let lastGroup = '';
            list.forEach(a => {
                if (a.group !== lastGroup) {
                    html += `<div class="col-span-1 md:col-span-2 mt-6 mb-1">
                                <div class="text-[10px] font-mono uppercase tracking-widest text-[#666] border-b border-[#222] pb-2">${a.group}</div>
                            </div>`;
                    lastGroup = a.group;
                }
                html += addonCard(a, inputName);
            });
            container.innerHTML = html;
        }
        renderAddons('hw-addons-grid', HW_ADDONS, 'peripherals');
        renderAddons('sw-addons-grid', SW_ADDONS, 'swaddons');

        function updateSummary() {
            if (currentStep !== 4) return;
            
            const antenna = document.querySelector('input[name="antenna"]:checked')?.value || 'interna';
            const antennaLabel = {
                interna: 'INTEGRADA (0 dBi)',
                dip2: 'DIPOLO 2 dBi',
                patch3: 'PATCH 3 dBi',
                panel45: 'PAINEL 4.5 dBi',
                circ6: 'CIRCULAR 6 dBi',
                panel8: 'PAINEL 8 dBi'
            }[antenna];
            
            const hwChecked = document.querySelectorAll('input[name="peripherals"]:checked');
            const swChecked = document.querySelectorAll('input[name="swaddons"]:checked');
            let hwList = Array.from(hwChecked).map(cb => cb.value.toUpperCase()).join(', ');
            if (hwList === "") hwList = "NONE";
            let swList = Array.from(swChecked).map(cb => cb.value.toUpperCase()).join(', ');
            if (swList === "") swList = "NONE";

            const flags = [];
            const hwById = {};
            HW_ADDONS.forEach(a => hwById[a.v] = a);
            const swById = {};
            SW_ADDONS.forEach(a => swById[a.v] = a);
            hwChecked.forEach(cb => { if (hwById[cb.value]?.flag) flags.push('-D' + hwById[cb.value].flag); });
            swChecked.forEach(cb => { if (swById[cb.value]?.flag) flags.push('-D' + swById[cb.value].flag); });

            const warnings = [];
            swChecked.forEach(cb => {
                const dep = swById[cb.value]?.dep;
                if (dep && !document.querySelector(`input[name="peripherals"][value="${dep}"]`)?.checked) {
                    const depName = hwById[dep]?.name || dep;
                    warnings.push(`${swById[cb.value].name} exige o módulo ${depName} (passo anterior).`);
                }
            });
            if (Array.from(hwChecked).some(cb => cb.value === 'oled')) warnings.push('OLED SSD1306 ainda não tem driver no firmware — flag TRAKR_HAS_OLED entra no build e ativa quando implementado.');
            const roadmapSw = Array.from(swChecked).some(cb => swById[cb.value]?.badge === 'ROADMAP');
            const roadmapHw = Array.from(hwChecked).some(cb => hwById[cb.value]?.badge === 'ROADMAP');
            if (roadmapSw || roadmapHw) warnings.push('Addons do roadmap não existem no firmware atual — o build os ignora até a implementação.');

            const sumAntenna = document.getElementById('sum-antenna');
            const sumPeriph = document.getElementById('sum-periph');
            const sumSw = document.getElementById('sum-sw');
            const sumFlags = document.getElementById('sum-flags');
            const sumWarnings = document.getElementById('sum-warnings');
            
            if(sumAntenna) sumAntenna.innerText = antennaLabel;
            if(sumPeriph) sumPeriph.innerText = hwList;
            if(sumSw) sumSw.innerText = swList;
            if(sumFlags) sumFlags.innerText = flags.join(' ') || '-DNONE';
            if(sumWarnings) {
                if(warnings.length) {
                    sumWarnings.classList.remove('hidden');
                    sumWarnings.innerHTML = warnings.map(w => `> AVISO: ${w}`).join('<br>');
                } else {
                    sumWarnings.classList.add('hidden');
                }
            }
        }

        function updateCounts() {
            const hw = document.querySelectorAll('input[name="peripherals"]:checked').length;
            const sw = document.querySelectorAll('input[name="swaddons"]:checked').length;
            const hwCount = document.getElementById('hw-count');
            const swCount = document.getElementById('sw-count');
            if(hwCount) hwCount.innerText = `${hw} selecionados`;
            if(swCount) swCount.innerText = `${sw} selecionados`;
        }

        function buildConfigJson() {
            const antenna = document.querySelector('input[name="antenna"]:checked')?.value || 'interna';
            const hardware = Array.from(document.querySelectorAll('input[name="peripherals"]:checked')).map(cb => cb.value);
            const software = Array.from(document.querySelectorAll('input[name="swaddons"]:checked')).map(cb => cb.value);
            const flags = [];
            const hwById = {};
            HW_ADDONS.forEach(a => hwById[a.v] = a);
            const swById = {};
            SW_ADDONS.forEach(a => swById[a.v] = a);
            hardware.forEach(v => { if (hwById[v]?.flag) flags.push(hwById[v].flag); });
            software.forEach(v => { if (swById[v]?.flag) flags.push(swById[v].flag); });
            return {
                "schema": "trakr-build-config/v1",
                "target": "esp32",
                "antenna": antenna,
                "hardware_addons": hardware,
                "software_addons": software,
                "build_flags": flags
            };
        }

        function fillManifest() {
            const el = document.getElementById('modal-manifest');
            if(el) el.textContent = JSON.stringify(buildConfigJson(), null, 2);
        }

        function downloadConfig() {
            const config = buildConfigJson();
            const blob = new Blob([JSON.stringify(config, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'trakr-config.json';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            fillManifest();
            openModal(modalDownload);
        }

        function showStep(step) {
            // Hide all
            document.querySelectorAll('.step-content').forEach(el => {
                el.classList.remove('active');
            });
            // Show current
            const currentEl = document.getElementById(`step-${step}`);
            if(currentEl) currentEl.classList.add('active');

            // Update Header
            if(stepIndicator) stepIndicator.innerText = `ETAPA ${step} DE ${steps}`;
            if(stepTitle) stepTitle.innerText = stepTitles[step-1];
            if(progressBar) progressBar.style.width = `${(step / steps) * 100}%`;

            // Buttons
            if (step === 1) {
                if(btnPrev) btnPrev.classList.add('hidden');
            } else {
                if(btnPrev) btnPrev.classList.remove('hidden');
            }

            if (step === steps) {
                if(btnNext) btnNext.classList.add('hidden');
                updateSummary();
            } else {
                if(btnNext) btnNext.classList.remove('hidden');
            }
        }

        if(btnNext) {
            btnNext.addEventListener('click', () => {
                if (currentStep < steps) {
                    currentStep++;
                    showStep(currentStep);
                }
            });
        }

        if(btnPrev) {
            btnPrev.addEventListener('click', () => {
                if (currentStep > 1) {
                    currentStep--;
                    showStep(currentStep);
                }
            });
        }

        // Add change listeners to auto-update summary if they click back and forth
        document.querySelectorAll('input').forEach(input => {
            input.addEventListener('change', () => {
                updateSummary();
                updateCounts();
            });
        });
        updateCounts();

        // Modal Logic
        const modalDownload = document.getElementById('modal-download');
        const modalSerial = document.getElementById('modal-serial');
        
        const btnDownloadBin = document.getElementById('btn-download-bin');
        const btnWebSerial = document.getElementById('btn-web-serial');
        
        function openModal(modal) {
            modal.classList.remove('hidden', 'pointer-events-none');
            // small delay for transition
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                const content = modal.querySelector('div[id^="content-modal"]');
                if(content) {
                    content.classList.remove('scale-95');
                    content.classList.add('scale-100');
                }
            }, 10);
        }

        function closeModal(modal) {
            modal.classList.add('opacity-0');
            const content = modal.querySelector('div[id^="content-modal"]');
            if(content) {
                content.classList.remove('scale-100');
                content.classList.add('scale-95');
            }
            setTimeout(() => {
                modal.classList.add('pointer-events-none');
            }, 500);
        }

        // Close buttons
        document.querySelectorAll('.close-modal').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const modal = e.target.closest('.fixed.inset-0');
                if(modal) closeModal(modal);
            });
        });

        // Download .bin trigger
        if(btnDownloadBin) {
            btnDownloadBin.addEventListener('click', () => {
                updateSummary();
                fillManifest();
                openModal(modalDownload);
            });
        }

        // Download trakr-config.json trigger
        const btnDownloadConfig = document.getElementById('btn-download-config');
        if(btnDownloadConfig) {
            btnDownloadConfig.addEventListener('click', downloadConfig);
        }

        // Web Serial trigger (Simulated for Demo)
        if(btnWebSerial) {
            // Note: Since esp-web-install-button handles its own click, 
            // we intercept the wrapper for the visual demo here, or attach click.
            // In a real environment, you listen to esp-web-install-button events.
            btnWebSerial.addEventListener('click', (e) => {
                e.preventDefault(); // Stop native behavior for UI demo
                
                openModal(modalSerial);
                
                // Reset state
                document.getElementById('serial-state-loading').classList.remove('hidden');
                document.getElementById('serial-state-loading').classList.add('flex');
                document.getElementById('serial-state-success').classList.add('hidden');
                document.getElementById('serial-state-success').classList.remove('flex');
                
                const progress = document.getElementById('serial-progress');
                const pct = document.getElementById('serial-pct');
                const log = document.getElementById('serial-log');
                
                progress.style.width = '0%';
                pct.innerText = '0%';
                log.innerText = 'Conectando ao /dev/ttyUSB0...';
                
                // Simulate flashing process
                setTimeout(() => { log.innerText = 'Apagando flash...'; progress.style.width = '10%'; pct.innerText = '10%'; }, 1000);
                setTimeout(() => { log.innerText = 'Gravando em 0x10000... (24%)'; progress.style.width = '24%'; pct.innerText = '24%'; }, 2000);
                setTimeout(() => { log.innerText = 'Gravando em 0x10000... (58%)'; progress.style.width = '58%'; pct.innerText = '58%'; }, 3000);
                setTimeout(() => { log.innerText = 'Gravando em 0x10000... (89%)'; progress.style.width = '89%'; pct.innerText = '89%'; }, 4000);
                setTimeout(() => { log.innerText = 'Verificando hash do payload...'; progress.style.width = '100%'; pct.innerText = '100%'; }, 5000);
                
                setTimeout(() => {
                    document.getElementById('serial-state-loading').classList.add('hidden');
                    document.getElementById('serial-state-loading').classList.remove('flex');
                    document.getElementById('serial-state-success').classList.remove('hidden');
                    document.getElementById('serial-state-success').classList.add('flex');
                }, 6000);
            });
        }

        // APK Release Info
        const apkVersionEl = document.getElementById('apk-version');
        const apkSizeEl = document.getElementById('apk-size');
        const apkDownloadEl = document.getElementById('apk-download');
        fetch('https://api.github.com/repos/charlles-dev/trakr/releases/latest')
            .then(r => r.ok ? r.json() : Promise.reject())
            .then(release => {
                const asset = (release.assets || []).find(a => a.name === 'trakr.apk');
                if(apkVersionEl) apkVersionEl.textContent = release.tag_name;
                if(apkSizeEl && asset) apkSizeEl.textContent = (asset.size / 1048576).toFixed(1) + ' MB';
                if(asset && apkDownloadEl) apkDownloadEl.href = asset.browser_download_url;
            })
            .catch(() => {
                if(apkVersionEl) apkVersionEl.textContent = 'v0.0.0';
            });

        // Custom build status
        const binStatus = document.getElementById('bin-status');
        fetch('https://api.github.com/repos/charlles-dev/trakr/releases/tags/custom-build')
            .then(r => r.ok ? r.json() : Promise.reject())
            .then(release => {
                const asset = (release.assets || []).find(a => a.name === 'trakr-node.bin');
                if(asset && binStatus) {
                    binStatus.textContent = `Último build: ${new Date(asset.updated_at).toLocaleString('pt-BR')} · ${(asset.size / 1048576).toFixed(1)} MB`;
                } else if(binStatus) {
                    binStatus.textContent = 'Ainda não existe build customizado — dispare o workflow Firmware Build.';
                }
            })
            .catch(() => {
                if(binStatus) binStatus.textContent = 'Ainda não existe build customizado — dispare o workflow Firmware Build.';
            });
    </script>
</body>
</html>
