    <!-- Lenis for Smooth Scroll & Parallax -->
    <script src="https://unpkg.com/lenis@1.1.9/dist/lenis.min.js" is:inline></script>
    <script is:inline>
        // 58. Lenis Initialization (Simplified to prevent bugs)
        const lenis = new Lenis();

        function raf(time) {
            lenis.raf(time);
            requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // 59. Circular Progress, Parallax Engine, Masks & Gear Rotation
        const progressRing = document.getElementById('scroll-progress-ring');
        const parallaxTexts = document.querySelectorAll('.parallax-text');
        const blurElements = document.querySelectorAll('.blur-on-scroll');
        const scrollRotateElements = document.querySelectorAll('.scroll-rotate');
        const faqSection = document.getElementById('faq');
        const bootScreenLenis = document.getElementById('boot-screen');
        const bodyEl = document.body;
        const circumference = 251.2;
        let globalRot = 0;

        // Intersection Observer for Reveal Masks
        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if(entry.isIntersecting) {
                    entry.target.classList.add('is-revealed');
                }
            });
        }, { threshold: 0.2 });
        document.querySelectorAll('.reveal-mask').forEach(el => revealObserver.observe(el));

        lenis.on('scroll', (e) => {
            try {
                // Velocity for Gears Rotation
                const velocity = e.velocity || 0;
                globalRot += velocity * 0.5;
                scrollRotateElements.forEach(el => {
                    const isReverse = el.style.animationDirection === 'reverse' ? -1 : 1;
                    if(!isNaN(globalRot)) el.style.transform = `rotate(${globalRot * isReverse}deg)`;
                });

                // Progress Bar
                const scrollProgress = e.progress || 0; 
                const offset = circumference - (scrollProgress * circumference);
                if(progressRing && !isNaN(offset)) progressRing.style.strokeDashoffset = offset;

                // Parallax TipogrÃƒÂ¡fico
                parallaxTexts.forEach(el => {
                    const speed = el.dataset.speed || 0.1;
                    const y = (e.animatedScroll || window.scrollY) * speed;
                    el.style.transform = `translateY(${y}px)`;
                });

                // Blur on scroll (distance from center)
                const viewportCenter = window.scrollY + (window.innerHeight / 2);
                blurElements.forEach(el => {
                    const rect = el.getBoundingClientRect();
                    const elCenter = rect.top + window.scrollY + (rect.height / 2);
                    const distance = Math.abs(viewportCenter - elCenter);
                    const blurValue = Math.max(0, (distance - window.innerHeight/2) * 0.02);
                    if(!isNaN(blurValue)) el.style.filter = `blur(${Math.min(blurValue, 10)}px)`;
                });

                // Variable Font Weight (Fino -> Bold on center)
                document.querySelectorAll('.var-weight').forEach(el => {
                    const rect = el.getBoundingClientRect();
                    const elCenter = rect.top + window.scrollY + (rect.height / 2);
                    const distance = Math.abs(viewportCenter - elCenter);
                    const weight = Math.max(100, 900 - (distance * 0.8));
                    if(!isNaN(weight)) el.style.fontVariationSettings = `"wght" ${Math.min(900, weight)}`;
                });

                // Horizontal Scroll Logic
                const horizontalSection = document.getElementById('horizontal-scroll-section');
                const horizontalTrack = document.getElementById('horizontal-track');
                if(horizontalSection && horizontalTrack && window.innerWidth >= 1024) {
                    const rect = horizontalSection.getBoundingClientRect();
                    if(rect.top <= 0 && rect.bottom >= window.innerHeight) {
                        const scrollFraction = Math.abs(rect.top) / (rect.height - window.innerHeight);
                        const maxTranslate = horizontalTrack.scrollWidth - window.innerWidth;
                        if(!isNaN(scrollFraction) && !isNaN(maxTranslate)) horizontalTrack.style.transform = `translate3d(-${scrollFraction * maxTranslate}px, 0, 0)`;
                    } else if (rect.top > 0) {
                        horizontalTrack.style.transform = `translate3d(0, 0, 0)`;
                    } else if (rect.bottom < window.innerHeight) {
                        const maxTranslate = horizontalTrack.scrollWidth - window.innerWidth;
                        if(!isNaN(maxTranslate)) horizontalTrack.style.transform = `translate3d(-${maxTranslate}px, 0, 0)`;
                    }
                } else if (horizontalTrack) {
                    horizontalTrack.style.transform = `translate3d(0, 0, 0)`;
                }

                // Ink Drop (Tinta escorrendo)
                document.querySelectorAll('.ink-drop').forEach(el => {
                    const rect = el.getBoundingClientRect();
                    const elCenter = rect.top + (rect.height / 2);
                    if (elCenter < window.innerHeight / 2) {
                        const progress = 1 - (elCenter / (window.innerHeight / 2));
                        const size = Math.min(2000, 100 + (progress * 2000));
                        if(!isNaN(size)) {
                            el.style.setProperty('--ink-size', `${size}%`);
                            el.style.zIndex = "99";
                        }
                    } else {
                        el.style.setProperty('--ink-size', `100%`);
                        el.style.zIndex = "1";
                    }
                });

                // Drastic Background Color Change (Preto para Laranja) no FAQ
                if(faqSection) {
                    const rect = faqSection.getBoundingClientRect();
                    if(rect.top < window.innerHeight * 0.6 && rect.bottom > window.innerHeight * 0.4) {
                        bodyEl.classList.add('bg-[#20B898]');
                        bodyEl.classList.remove('bg-[#0B1210]');
                        if(bootScreenLenis) {
                            bootScreenLenis.style.backgroundColor = '#20B898';
                            bootScreenLenis.style.color = '#0B1210';
                        }
                    } else {
                        bodyEl.classList.add('bg-[#0B1210]');
                        bodyEl.classList.remove('bg-[#20B898]');
                        if(bootScreenLenis) {
                            bootScreenLenis.style.backgroundColor = '#0B1210';
                            bootScreenLenis.style.color = '#20B898';
                        }
                    }
                }
            } catch (err) {
                console.error("Lenis scroll event error:", err);
            }
        });
    </script>

    <!-- Scripts (Cursor, Favicon, Glitch, Theme, Gradient) -->
    <div id="cursor-premium"></div>
    
    <script is:inline>
        // 54. Haptic Web Audio (UI Tick)
        const uiTickAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const playTick = () => {
            if(uiTickAudioCtx.state === 'suspended') uiTickAudioCtx.resume();
            const osc = uiTickAudioCtx.createOscillator();
            const gain = uiTickAudioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(800, uiTickAudioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(100, uiTickAudioCtx.currentTime + 0.05);
            gain.gain.setValueAtTime(0.1, uiTickAudioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, uiTickAudioCtx.currentTime + 0.05);
            osc.connect(gain);
            gain.connect(uiTickAudioCtx.destination);
            osc.start();
            osc.stop(uiTickAudioCtx.currentTime + 0.05);
        };
        document.querySelectorAll('button, .nav-link, .sector-btn').forEach(btn => {
            btn.addEventListener('mousedown', playTick);
        });

        // 51 & 52. Custom Cursor Premium (Inverted) & Flashlight Mask
        const cursorPremium = document.getElementById('cursor-premium');
        const flashlight = document.querySelector('.flashlight-mask');
        let mouseX = window.innerWidth / 2, mouseY = window.innerHeight / 2, cursorX = window.innerWidth / 2, cursorY = window.innerHeight / 2;
        
        window.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
            if(flashlight) {
                flashlight.style.setProperty('--mouse-x', `${mouseX}px`);
                flashlight.style.setProperty('--mouse-y', `${mouseY}px`);
            }
        });
        
        function animateCursor() {
            // Smooth lerp
            cursorX += (mouseX - cursorX) * 0.3;
            cursorY += (mouseY - cursorY) * 0.3;
            if (cursorPremium) {
                cursorPremium.style.left = `${cursorX}px`;
                cursorPremium.style.top = `${cursorY}px`;
            }
            requestAnimationFrame(animateCursor);
        }
        animateCursor();
        
        document.querySelectorAll('a, button, article, .group, .bento-card').forEach(el => {
            el.addEventListener('mouseenter', () => {
                if(cursorPremium) cursorPremium.classList.add('cursor-hover');
            });
            el.addEventListener('mouseleave', () => {
                if(cursorPremium) cursorPremium.classList.remove('cursor-hover');
            });
        });

        // 53. Magnetic Buttons
        const magneticBtns = document.querySelectorAll('.magnetic-btn');
        magneticBtns.forEach(btn => {
            btn.addEventListener('mousemove', (e) => {
                const rect = btn.getBoundingClientRect();
                const x = e.clientX - rect.left - rect.width / 2;
                const y = e.clientY - rect.top - rect.height / 2;
                btn.style.transform = `translate(${x * 0.3}px, ${y * 0.3}px)`;
                btn.style.transition = 'transform 0.1s ease-out';
            });
            btn.addEventListener('mouseleave', () => {
                btn.style.transform = `translate(0px, 0px)`;
                btn.style.transition = 'transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1)';
            });
        });

        // 10. Dynamic Favicon
        const link = document.querySelector("link[rel~='icon']") || document.createElement('link');
        link.rel = 'icon';
        document.head.appendChild(link);
        link.href = '/favicon.svg';

        // APK Release Info
        const apkVersion = document.getElementById('apk-version');
        const apkSize = document.getElementById('apk-size');
        const apkDate = document.getElementById('apk-date');
        const apkDownload = document.getElementById('apk-download');
        fetch('https://api.github.com/repos/charlles-dev/trakr/releases/latest')
            .then(r => r.ok ? r.json() : Promise.reject())
            .then(release => {
                const asset = (release.assets || []).find(a => a.name === 'trakr.apk');
                if(apkVersion) apkVersion.textContent = release.tag_name;
                if(apkSize && asset) apkSize.textContent = (asset.size / 1048576).toFixed(1) + ' MB';
                if(apkDate && asset) apkDate.textContent = 'Publicado em ' + new Date(asset.updated_at).toLocaleDateString('pt-BR');
                if(asset && apkDownload) apkDownload.href = asset.browser_download_url;
            })
            .catch(() => {
                if(apkVersion) apkVersion.textContent = 'v0.0.0';
                if(apkSize) apkSize.textContent = 'Mais recente';
            });

        window.addEventListener('blur', () => {
            link.href = 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="%2320B898"/></svg>';
            document.title = "Conexão perdida...";
        });
        window.addEventListener('focus', () => {
            link.href = '/favicon.svg';
            document.title = "Trakr | Rastreamento inteligente de ferramentas";
        });

        // 2. Light Mode
        const themeBtn = document.getElementById('theme-toggle');
        if(themeBtn) {
            themeBtn.addEventListener('click', () => {
                document.body.classList.toggle('light-mode');
            });
        }

        // 5. Gradient Border / Spotlight on Hover
        document.querySelectorAll('.gradient-card, .bento-card').forEach(card => {
            card.addEventListener('mousemove', e => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                card.style.setProperty('--mouse-x', `${x}px`);
                card.style.setProperty('--mouse-y', `${y}px`);
            });
        });

        // 6. Glitch on load
        const heroText = document.querySelector('.hero-text');
        if(heroText) {
            heroText.classList.add('animate-glitch');
            setTimeout(() => heroText.classList.remove('animate-glitch'), 800);
            
            // Random glitches later
            setInterval(() => {
                if (Math.random() > 0.8) {
                    heroText.classList.add('animate-glitch');
                    setTimeout(() => heroText.classList.remove('animate-glitch'), 200);
                }
            }, 5000);
        }

        // 15. Scroll Indicator
        const scrollProgress = document.getElementById('scroll-progress');
        window.addEventListener('scroll', () => {
            if(scrollProgress) {
                const scrollPx = document.documentElement.scrollTop;
                const winHeightPx = document.documentElement.scrollHeight - document.documentElement.clientHeight;
                const scrolled = scrollPx / winHeightPx;
                scrollProgress.style.strokeDashoffset = 251 - (251 * scrolled);
            }
        });

        // 13. Isometric Cards
        document.querySelectorAll('article.group').forEach(card => {
            const innerDiv = card.querySelector('div.relative');
            if(innerDiv) {
                card.addEventListener('mousemove', e => {
                    const rect = card.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const centerX = rect.width / 2;
                    const centerY = rect.height / 2;
                    const rotateX = ((y - centerY) / centerY) * -10;
                    const rotateY = ((x - centerX) / centerX) * 10;
                    innerDiv.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
                    innerDiv.style.transition = 'none';
                });
                card.addEventListener('mouseleave', () => {
                    innerDiv.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
                    innerDiv.style.transition = 'transform 0.5s ease';
                });
            }
        });

        // 20. Mobile Menu Toggle
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileModal = document.getElementById('mobile-modal');
        let menuOpen = false;
        
        if (mobileBtn && mobileModal) {
            mobileBtn.addEventListener('click', () => {
                menuOpen = !menuOpen;
                const spans = mobileBtn.querySelectorAll('span');
                if(menuOpen) {
                    mobileModal.classList.remove('hidden');
                    mobileModal.classList.add('flex');
                    setTimeout(() => mobileModal.classList.replace('opacity-0', 'opacity-100'), 10);
                    spans[0].style.transform = 'translateY(6px) rotate(45deg)';
                    spans[1].style.opacity = '0';
                    spans[2].style.transform = 'translateY(-6px) rotate(-45deg)';
                } else {
                    mobileModal.classList.replace('opacity-100', 'opacity-0');
                    setTimeout(() => {
                        mobileModal.classList.add('hidden');
                        mobileModal.classList.remove('flex');
                    }, 300);
                    spans[0].style.transform = 'none';
                    spans[1].style.opacity = '1';
                    spans[2].style.transform = 'none';
                }
            });
            document.querySelectorAll('.mobile-link').forEach(link => {
                link.addEventListener('click', () => {
                    if (menuOpen) mobileBtn.click();
                });
            });
        }
        // 21. Reveal on Scroll
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if(entry.isIntersecting) {
                    entry.target.classList.add('revealed');
                }
            });
        }, { threshold: 0.1 });
        document.querySelectorAll('.reveal-up').forEach(el => observer.observe(el));

        // 22. Magnetic Buttons
        const magnetWrap = document.querySelector('.magnetic-wrap');
        const magnetBtn = document.querySelector('.magnetic-btn');
        if(magnetWrap && magnetBtn) {
            magnetWrap.addEventListener('mousemove', (e) => {
                const rect = magnetWrap.getBoundingClientRect();
                const x = e.clientX - rect.left - rect.width/2;
                const y = e.clientY - rect.top - rect.height/2;
                magnetBtn.style.transform = `translate(${x * 0.3}px, ${y * 0.3}px)`;
            });
            magnetWrap.addEventListener('mouseleave', () => {
                magnetBtn.style.transform = `translate(0px, 0px)`;
            });
        }

        // 23. Parallax Background
        const parallaxBg = document.getElementById('parallax-bg');
        window.addEventListener('scroll', () => {
            if(parallaxBg) {
                const scrollPx = document.documentElement.scrollTop;
                parallaxBg.style.transform = `perspective(1000px) rotateX(60deg) scale(2) translateY(${scrollPx * 0.4}px)`;
            }
        });

        // 27. Typewriter Effect
        const twText = document.querySelector('#typewriter-text .typing-target');
        if(twText) {
            const textToType = document.getElementById('typewriter-text').getAttribute('data-text');
            let twIndex = 0;
            setTimeout(() => {
                const typeWriter = setInterval(() => {
                    twText.textContent += textToType.charAt(twIndex);
                    twIndex++;
                    if(twIndex >= textToType.length) clearInterval(typeWriter);
                }, 100);
            }, 1000);
        }

        // 45. Bento Grid Depth Counter
        const depthCounter = document.getElementById('depth-counter');
        if(depthCounter) {
            let currentDepth = 0;
            const targetDepth = -4000;
            
            const observer = new IntersectionObserver((entries) => {
                if(entries[0].isIntersecting) {
                    const depthInterval = setInterval(() => {
                        currentDepth -= 47;
                        if(currentDepth <= targetDepth) {
                            currentDepth = targetDepth;
                            clearInterval(depthInterval);
                        }
                        depthCounter.textContent = currentDepth.toLocaleString();
                    }, 20);
                    observer.disconnect();
                }
            }, { threshold: 0.5 });
            
            observer.observe(depthCounter);
        }
        // 31. Boot Sequence (RFID Calibration + SVG Draw)
        const bootLines = [
            "Inicializando Trakr Edge...",
            "Montando LITTLEFS... OK.",
            "Iniciando transceptor LoRa... OK.",
            "Verificação da antena RFID UHF... OK.",
            "Estabelecendo link neural... ESPERA.",
            "Pronto."
        ];
        const bootScreen = document.getElementById('boot-screen');
        const bootLogs = document.getElementById('boot-logs');
        const calibProgress = document.getElementById('calibration-progress');
        const svgPath = document.getElementById('trakr-loader-path');
        const calibText = document.getElementById('calibration-text');

        if(bootScreen && bootLogs) {
            // Start SVG draw
            setTimeout(() => {
                if(svgPath) svgPath.style.strokeDashoffset = '0';
            }, 100);

            let bIndex = 0;
            const bootInterval = setInterval(() => {
                bootLogs.innerHTML += `<div>${bootLines[bIndex]}</div>`;
                if(calibProgress) calibProgress.style.width = `${((bIndex + 1) / bootLines.length) * 100}%`;
                
                bIndex++;
                if(bIndex >= bootLines.length) {
                    clearInterval(bootInterval);
                    if(calibText) {
                        calibText.textContent = 'SYSTEM READY';
                        calibText.classList.remove('animate-pulse');
                        calibText.classList.add('text-white');
                    }
                    setTimeout(() => {
                        // Slide curtain right
                        bootScreen.style.transform = 'translateX(100%)';
                        setTimeout(() => bootScreen.style.display = 'none', 1000);
                        
                        // Trigger Hero Drop
                        document.body.classList.add('boot-complete');
                    }, 800);
                }
            }, 300);
        }

        // 36. Nav Shrink
        const mainNav = document.getElementById('main-nav');
        window.addEventListener('scroll', () => {
            if(mainNav) {
                if(window.scrollY > 50) {
                    mainNav.classList.add('shrunk');
                } else {
                    mainNav.classList.remove('shrunk');
                }
            }
        });

        // 29. Nav CPU Scroll & Flash
        const navCpu = document.getElementById('nav-btn-cpu');
        const featCpu = document.getElementById('feature-cpu');
        if(navCpu && featCpu) {
            navCpu.addEventListener('click', (e) => {
                e.preventDefault();
                featCpu.scrollIntoView({ behavior: 'smooth', block: 'center' });
                setTimeout(() => {
                    featCpu.classList.add('flash-focus');
                    setTimeout(() => featCpu.classList.remove('flash-focus'), 1500);
                }, 500);
            });
        }



        // 37. Datacenter Noise (Audio)
        const btnAudio = document.getElementById('btn-audio');
        let audioCtx, noiseNode, gainNode;

        if(btnAudio) {
            btnAudio.addEventListener('click', () => {
                if(!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                    const bufferSize = audioCtx.sampleRate * 2;
                    const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
                    const output = buffer.getChannelData(0);
                    let lastOut = 0;
                    for (let i = 0; i < bufferSize; i++) {
                        const white = Math.random() * 2 - 1;
                        output[i] = (lastOut + (0.02 * white)) / 1.02;
                        lastOut = output[i];
                        output[i] *= 3.5; 
                    }
                    
                    noiseNode = audioCtx.createBufferSource();
                    noiseNode.buffer = buffer;
                    noiseNode.loop = true;
                    
                    const filter = audioCtx.createBiquadFilter();
                    filter.type = 'lowpass';
                    filter.frequency.value = 400;
                    
                    gainNode = audioCtx.createGain();
                    gainNode.gain.value = 0.5;
                    
                    noiseNode.connect(filter);
                    filter.connect(gainNode);
                    gainNode.connect(audioCtx.destination);
                    
                    noiseNode.start(0);
                    btnAudio.innerHTML = `<iconify-icon icon="lucide:volume-2" id="audio-icon" class="text-[#20B898] text-xl"></iconify-icon> AUDIO ON`;
                } else {
                    if(audioCtx.state === 'running') {
                        audioCtx.suspend();
                        btnAudio.innerHTML = `<iconify-icon icon="lucide:volume-x" id="audio-icon" class="text-xl"></iconify-icon>`;
                    } else if(audioCtx.state === 'suspended') {
                        audioCtx.resume();
btnAudio.innerHTML = `<iconify-icon icon="lucide:volume-2" id="audio-icon" class="text-[#20B898] text-xl"></iconify-icon>`;
                    }
                }
            });
        }

        // --- Category 4 Logic ---

        // 1. Remove Skeleton when Fonts Load
        document.fonts.ready.then(() => {
            setTimeout(() => {
                document.querySelectorAll('.font-skeleton').forEach(el => {
                    el.classList.remove('font-skeleton');
                });
            }, 800);
        });

        // 2. Modal Darken Toggle (Simulate with "Build Yours" CTA)
        const ctaBtn = document.getElementById('nav-cta-btn');
        if (ctaBtn) {
            ctaBtn.addEventListener('click', (e) => {
                // Prevent scrolling to #contact just to show the modal demo effect
                e.preventDefault();
                document.body.classList.toggle('modal-open');
                
                // Auto close after 3 seconds for demo purposes
                setTimeout(() => {
                    document.body.classList.remove('modal-open');
                }, 3000);
            });
        }

        // 3. CRT Turn Off on Exit
        document.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', (e) => {
                const href = link.getAttribute('href');
                const target = link.getAttribute('target');
                
                // Only trigger on actual navigation links (not # hashes or blank targets)
                if (href && !href.startsWith('#') && target !== '_blank') {
                    e.preventDefault();
                    document.body.classList.add('crt-turn-off');
                    setTimeout(() => {
                        window.location.href = href;
                    }, 400); // Wait for animation
                }
            });
        });
        
        // 4. Idle Glowing Deploy Button
        let idleTimer;
        function resetIdleTimer() {
            clearTimeout(idleTimer);
            if(ctaBtn) {
                ctaBtn.classList.remove('attention-glow');
                idleTimer = setTimeout(() => {
                    ctaBtn.classList.add('attention-glow');
                }, 30000); // 30 seconds
            }
        }
        window.addEventListener('mousemove', resetIdleTimer);
        window.addEventListener('keypress', resetIdleTimer);
        window.addEventListener('scroll', resetIdleTimer);
        resetIdleTimer();

        // Try beforeunload (browsers usually ignore visual changes here, but good practice for legacy)
        window.addEventListener('beforeunload', (e) => {
            document.body.classList.add('crt-turn-off');
        });
        // --- End Category 4 & 5 Logic ---
    </script>
