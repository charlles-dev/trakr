---
import { ClientRouter } from 'astro:transitions';
// Midnight Editorial Edge Computing
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trakr | Rastreamento inteligente de ferramentas</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <!-- We can keep the CDN or remove it since we installed tailwind, but since you want it identical to the HTML provided, I will keep it identical to ensure it works exactly as you saw it -->
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js" is:inline></script>
    <style is:inline>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

        @font-face {
            font-family: 'Satoshi';
            src: url('https://vgbujcuwptvheqijyjbe.supabase.co/storage/v1/object/public/hmac-uploads/uploads/4aed2f49-a476-436f-bae8-f31aa18f46fa/1767920861040-60c1c779/Satoshi-Variable.woff2') format('woff2');
            font-weight: 300 900;
            font-display: swap;
            font-style: normal;
        }

        :root {
            --font-satoshi: 'Satoshi', 'Inter', sans-serif;
            --color-bg: #0B1210;
            --color-accent: #20B898;
        }

        body {
            font-family: var(--font-satoshi);
            background-color: var(--color-bg);
            color: #e0e0e0;
        }

        .selection-coral::selection {
            background-color: var(--color-accent);
            color: white;
            text-shadow: 0 0 8px rgba(32, 184, 152, 0.8);
        }

        .glass-nav {
            background: rgba(17, 17, 17, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* 8. Tipografia Fluida */
        .hero-text {
            font-size: clamp(4rem, 13vw, 15rem);
            line-height: 0.9;
            letter-spacing: -0.05em;
        }

        .text-outline {
            -webkit-text-stroke: 1px rgba(255,255,255,0.2);
            color: transparent;
        }

        @keyframes scan {
            0% { transform: translateY(-100%); }
            100% { transform: translateY(100%); }
        }

        .scan-line {
            animation: scan 3s linear infinite;
        }

        /* 9. Scrollbar Customizada */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: var(--color-bg);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--color-accent);
            border-radius: 10px;
        }

        /* 2. Light Mode */
        body.light-mode {
            --color-bg: #f4f4f5;
            --color-accent: #e65c00;
            color: #111;
        }
        body.light-mode .bg-\[\#0B1210\] { background-color: var(--color-bg); }
        body.light-mode .text-white { color: #111; }
        body.light-mode .text-\[\#888888\] { color: #555; }
        body.light-mode .glass-nav { background: rgba(255,255,255,0.8); border-color: rgba(0,0,0,0.1); }
        body.light-mode .bg-\[\#111111\], body.light-mode .bg-\[\#1a1a1a\] { background-color: #fff; border-color: #ddd; }
        body.light-mode .text-outline { -webkit-text-stroke: 1px rgba(0,0,0,0.2); }

        /* 1. Cursor Customizado (Invertido Premium) & Ambient Mesh */
        body, a, button, article, input, details, summary { cursor: none !important; }
        #cursor-premium {
            position: fixed; top: 0; left: 0;
            width: 20px; height: 20px;
            background-color: #fff;
            border-radius: 50%;
            pointer-events: none;
            z-index: 10000;
            transform: translate(-50%, -50%);
            mix-blend-mode: difference;
            transition: width 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), height 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
            will-change: transform, width, height;
        }
        .cursor-hover { width: 60px !important; height: 60px !important; }

        /* 52. THE ULTIMATE BACKGROUND (CATEGORY 1 COMBINED) */
        .ambient-mesh {
            position: fixed; inset: 0; z-index: -1;
            background: #0B1210; /* Base */
            overflow: hidden; pointer-events: none;
        }

        /* Layer 1: Auroral Gradient */
        .ambient-mesh::before, .ambient-mesh::after {
            content: ''; position: absolute; width: 60vw; height: 60vw; border-radius: 50%;
            filter: blur(120px); opacity: 0.2;
            animation: float-blob 20s infinite alternate cubic-bezier(0.4, 0, 0.2, 1);
        }
        .ambient-mesh::before { background: #20B898; top: -10vw; left: -10vw; }
        .ambient-mesh::after { background: #4a5568; bottom: -10vw; right: -10vw; animation-delay: -10s; }

        /* Layer 2: Blueprint & Isometric Grid */
        .blueprint-grid {
            position: absolute; inset: 0; opacity: 0.05;
            background-image: 
                linear-gradient(rgba(255,255,255,1) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,1) 1px, transparent 1px);
            background-size: 50px 50px;
            transform: perspective(1000px) rotateX(60deg) rotateZ(45deg) scale(2);
            transform-origin: center;
        }

        /* Layer 3: Engineering Grid (Replaces Circles) */
        .topo-pattern {
            position: absolute; inset: 0; opacity: 0.1;
            background-image: 
                linear-gradient(to right, #20B898 1px, transparent 1px),
                linear-gradient(to bottom, #20B898 1px, transparent 1px);
            background-size: 80px 80px;
            animation: pan-grid 60s linear infinite;
        }

        /* Layer 4: ASCII Art Watermark */
        .ascii-art {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            color: rgba(255,255,255,0.02); font-family: monospace; font-size: 14px; line-height: 14px;
            white-space: pre; text-align: center;
        }

        /* Layer 6: Flashlight Effect */
        .flashlight-mask {
            position: absolute; inset: 0;
            background: rgba(0,0,0,0.85);
            -webkit-mask-image: radial-gradient(circle 350px at var(--mouse-x, 50vw) var(--mouse-y, 50vh), transparent 0%, black 100%);
            mask-image: radial-gradient(circle 350px at var(--mouse-x, 50vw) var(--mouse-y, 50vh), transparent 0%, black 100%);
        }

        /* Layer 7: TV Noise Overlay & Glass Edge */
        .tv-noise {
            position: fixed; inset: 0; z-index: 9997; opacity: 0.05; pointer-events: none; mix-blend-mode: overlay;
            background-image: url('data:image/svg+xml;utf8,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');
        }
        .glass-edges {
            position: fixed; inset: 0; z-index: 9998; pointer-events: none;
            box-shadow: inset 0 0 100px rgba(0,0,0,0.9), inset 5px 0 20px rgba(32,184,152,0.1), inset -5px 0 20px rgba(74,85,104,0.1);
        }

        @keyframes float-blob {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(20%, 10%) scale(1.2); }
            100% { transform: translate(-10%, 20%) scale(0.8); }
        }
        @keyframes pan-grid {
            from { background-position: 0 0; }
            to { background-position: 160px 160px; }
        }

        /* 6. Glitch */
        @keyframes glitch {
            0% { clip-path: inset(10% 0 30% 0); transform: translate(-2px, 2px); }
            20% { clip-path: inset(80% 0 5% 0); transform: translate(2px, -2px); }
            40% { clip-path: inset(40% 0 50% 0); transform: translate(2px, 2px); }
            60% { clip-path: inset(90% 0 5% 0); transform: translate(-2px, -2px); }
            80% { clip-path: inset(20% 0 60% 0); transform: translate(2px, 2px); }
            100% { clip-path: inset(0 0 0 0); transform: translate(0); }
        }
        .animate-glitch {
            animation: glitch 0.2s cubic-bezier(.25, .46, .45, .94) both infinite;
        }

        /* 5. Radial Gradient Border */
        .gradient-card {
            position: relative;
        }
        .gradient-card::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            border-radius: inherit;
            padding: 2px;
            background: radial-gradient(600px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(32, 184, 152, 0.4), transparent 40%);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .gradient-card:hover::before {
            opacity: 1;
        }
        
        body { cursor: none; }
        a, button, article { 
            cursor: none !important; 
            transition: background-color 0.4s ease, border-color 0.4s ease, color 0.4s ease, opacity 0.4s ease;
        }

        /* --- Categoria 4 CSS --- */
        
        /* Skeleton Loaders for Fonts */
        .font-skeleton {
            color: transparent !important;
            background: linear-gradient(90deg, #111 25%, #222 50%, #111 75%);
            background-size: 200% 100%;
            animation: skeleton-pulse 1.5s infinite linear;
            border-radius: 4px;
            user-select: none;
        }
        @keyframes skeleton-pulse { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

        /* Hero Drop with Motion Blur */
        .hero-drop {
            transform: translateY(-150px);
            filter: blur(20px);
            opacity: 0;
            transition: transform 1.2s cubic-bezier(0.34, 1.56, 0.64, 1), filter 1s ease-out, opacity 0.8s ease-out;
        }
        body.boot-complete .hero-drop {
            transform: translateY(0);
            filter: blur(0);
            opacity: 1;
        }

        /* Battery Scrollbar */
        ::-webkit-scrollbar { width: 12px; }
        ::-webkit-scrollbar-track { 
            background: #0a0a0a; 
            border-left: 1px dashed #333; 
        }
        ::-webkit-scrollbar-thumb { 
            background: #20B898; 
            border-radius: 10px; 
            border: 2px solid #0a0a0a;
            box-shadow: inset 0 0 6px rgba(0,0,0,0.5);
        }
        ::-webkit-scrollbar-thumb:hover { background: #ff8c78; }

        /* CRT Turn Off */
        body.crt-turn-off {
            animation: crt-off 0.4s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        }
        @keyframes crt-off {
            0% { transform: scale(1, 1); opacity: 1; filter: brightness(1); }
            50% { transform: scale(1, 0.01); opacity: 1; filter: brightness(10); }
            100% { transform: scale(0, 0); opacity: 0; filter: brightness(0); }
        }

        /* Modal Darken */
        #app-wrapper {
            transition: filter 0.5s ease;
        }
        body.modal-open #app-wrapper {
            filter: brightness(0.2) blur(3px);
            pointer-events: none;
        }
        /* --- End Categoria 4 CSS --- */

        /* --- Categoria 5 CSS --- */

        /* 1. Footer Marquee */
        @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-100%); } }
        .animate-marquee { animation: marquee 20s linear infinite; }
        
        /* 2. Fast Tooltips */
        .tooltip-wrap { position: relative; }
        .tooltip-wrap::after {
            content: attr(data-tooltip); position: absolute;
            bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%) translateY(4px);
            background: #111; color: white; border: 1px solid #333; padding: 4px 8px;
            border-radius: 4px; font-size: 10px; font-family: monospace; white-space: nowrap;
            opacity: 0; pointer-events: none; transition: opacity 0.1s ease 0.1s, transform 0.1s ease 0.1s;
            z-index: 200; box-shadow: 0 4px 6px rgba(0,0,0,0.5);
        }
        .tooltip-wrap:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }

        /* 3. Global Engineering Grid Lines */
        .global-grid {
            position: fixed; inset: 0; z-index: -1; pointer-events: none;
            background-image: 
                linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px);
            background-size: 100px 100px;
        }

        /* 4. Idle Glowing Button */
        .attention-glow {
            animation: idle-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        @keyframes idle-pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(32, 184, 152, 0); }
            50% { box-shadow: 0 0 20px 5px rgba(32, 184, 152, 0.3); }
        }

        /* 5. Elastic Physics for Hamburger Menu */
        #mobile-menu-btn span {
            transition: transform 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55), opacity 0.4s ease, background-color 0.3s;
        }
        #mobile-modal {
            transition: opacity 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55), transform 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            transform: translateY(-10px) scale(0.98);
        }
        #mobile-modal:not(.hidden) {
            transform: translateY(0) scale(1);
        }

        /* 6. Staggered Delay Accordions */
        details[open] summary ~ * {
            animation: stagger-reveal 0.6s cubic-bezier(0.19, 1, 0.22, 1) forwards;
            opacity: 0; transform: translateY(-10px);
        }
        /* Add delays via JS or nth-child if they were rendered dynamically, but since we use animation, it handles the slide down */
        @keyframes stagger-reveal {
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* --- End Categoria 5 CSS --- */

        /* 12. Animated Underline */
        .nav-link { position: relative; }
        .nav-link::after {
            content: ''; position: absolute;
            width: 0; height: 2px; bottom: -4px; left: 0;
            background-color: var(--color-accent);
            transition: width 0.3s ease;
        }
        .nav-link:hover::after { width: 100%; }

        /* 19. Animated Border Button */
        .btn-animated-border {
            position: relative; background: #111; z-index: 1;
            display: inline-block; /* Fix overflow bleed */
            overflow: hidden; border: none !important; color: white !important;
        }
        .btn-animated-border::before {
            content: ''; position: absolute;
            top: -50%; left: -50%; width: 200%; height: 200%;
            background: conic-gradient(transparent, var(--color-accent), transparent 30%);
            animation: rotate 4s linear infinite; z-index: -2;
        }
        .btn-animated-border::after {
            content: ''; position: absolute; inset: 2px;
            background: #20B898; border-radius: 6px; z-index: -1;
            transition: background 0.3s;
        }
        .btn-animated-border:not(:hover)::after { background: #0B1210; }
        @keyframes rotate { 100% { transform: rotate(360deg); } }

        /* 17. Reflexo nos Cards (Glossy) */
        .gradient-card::after {
            content: ''; position: absolute; top: -50%; left: -50%;
            width: 50%; height: 200%;
            background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.03) 50%, rgba(255,255,255,0) 100%);
            transform: rotate(45deg) translate(-100%, 0);
            transition: transform 0.6s; pointer-events: none; z-index: 10;
        }
        .gradient-card:hover::after {
            transform: rotate(45deg) translate(200%, 0);
        }

        /* 21. Reveal on Scroll */
        .reveal-up { opacity: 0; transform: translateY(40px); transition: opacity 0.8s ease-out, transform 0.8s ease-out; }
        .revealed { opacity: 1; transform: translateY(0); }

        /* 24. Text Split Reveal (Kinetic Elastic) */
        .char-reveal { display: inline-block; opacity: 0; transform: translateY(40px) scaleY(1.5); transform-origin: bottom; animation: charUp 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
        @keyframes charUp { to { opacity: 1; transform: translateY(0) scaleY(1); } }

        /* 25. Blur Mouse Tracker */
        .gradient-card { overflow: hidden; }
        .gradient-card::before {
            content: ''; position: absolute;
            top: var(--mouse-y); left: var(--mouse-x);
            width: 300px; height: 300px;
            background: rgba(32, 184, 152, 0.15);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            filter: blur(50px);
            pointer-events: none;
            z-index: 0;
        }
        .gradient-card:hover::before { opacity: 1; }
        .gradient-card > * { position: relative; z-index: 1; }

        /* 64. Reveal Mask (Cortina Preta) */
        .reveal-mask { position: relative; overflow: hidden; }
        .reveal-mask::after {
            content: ''; position: absolute; inset: -1px; background: #0B1210; z-index: 20;
            transform-origin: top; transition: transform 1.2s cubic-bezier(0.77, 0, 0.175, 1);
        }
        .reveal-mask.is-revealed::after { transform: scaleY(0); }

        /* 67. Scroll Velocity Rotation */
        .scroll-rotate { transform: rotate(var(--scroll-rot, 0deg)); will-change: transform; transition: transform 0.1s linear; }

        /* 65. Ink Drop Fill */
        .ink-drop { clip-path: circle(var(--ink-size, 0%) at center); transition: clip-path 0.1s ease-out; }

        /* 43. Bento Box Brutalist CSS */
        .bento-grid {
            display: grid;
            grid-template-columns: repeat(7, 300px);
            grid-template-rows: repeat(2, 300px);
            gap: 1.5rem;
        }
        .bento-card {
            background: #080808;
            border: 1px solid #222;
            border-radius: 1rem;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 2rem;
            transition: border-color 0.4s ease;
        }
        .bento-card:hover { border-color: #444; }
        .bento-card::before {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: inherit;
            padding: 2px;
            background: radial-gradient(600px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(32, 184, 152, 0.15), transparent 40%);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s;
            z-index: 10;
        }
        .bento-card:hover::before { opacity: 1; }
        /* Card Sizes */
        .bento-huge { grid-column: span 2; grid-row: span 2; }
        .bento-vert { grid-column: span 1; grid-row: span 2; }
        .bento-horiz { grid-column: span 2; grid-row: span 1; }
        .bento-sq { grid-column: span 1; grid-row: span 1; }
        
        @media (max-width: 1024px) {
            .bento-grid { grid-template-columns: repeat(2, 1fr); grid-template-rows: auto; width: 100%; }
            .bento-huge { grid-column: span 2; grid-row: span 2; min-height: 400px; }
            .bento-vert, .bento-horiz, .bento-sq { grid-column: span 1; grid-row: span 1; min-height: 300px; }
        }
        @media (max-width: 640px) {
            .bento-grid { grid-template-columns: 1fr; }
            .bento-huge, .bento-vert, .bento-horiz, .bento-sq { grid-column: span 1; grid-row: span 1; }
        }

        /* Micro-Animations */
        /* 1. The Red Line Cut */
        .cut-line {
            position: absolute; top: 30px; left: 30px; right: 30px;
            height: 2px; background: #FF3333; transform: scaleX(0); transform-origin: left;
            transition: transform 0.5s cubic-bezier(0.8,0,0.2,1);
        }
        .bento-huge:hover .cut-line { transform: scaleX(1); }
        
        /* 2. Dust Particles */
        .dust-container { position: absolute; inset: 0; pointer-events: none; opacity: 0.3; background-image: url('data:image/svg+xml,%3Csvg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"%3E%3Cfilter id="noiseFilter"%3E%3CfeTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/%3E%3C/filter%3E%3Crect width="100%25" height="100%25" filter="url(%23noiseFilter)"/%3E%3C/svg%3E'); animation: pan-dust 20s linear infinite; }
        @keyframes pan-dust { from { background-position: 0 0; } to { background-position: 100% 100%; } }
        
        /* 3. Terminal Log Marquee */
        .log-marquee { display: flex; flex-direction: column; gap: 0.5rem; transform: translateY(0); transition: transform 0.3s; }
        .bento-vert:hover .log-marquee { animation: scroll-up 5s linear infinite; }
        @keyframes scroll-up { 0% { transform: translateY(0); } 100% { transform: translateY(-50%); } }

        /* 30. Heartbeat Pulse */
        .animate-heartbeat { animation: heartbeat 1.5s infinite; }
        @keyframes heartbeat { 0% { transform: scale(1); } 14% { transform: scale(1.3); } 28% { transform: scale(1); } 42% { transform: scale(1.3); } 70% { transform: scale(1); } }

        /* 31. Boot Screen */
        #boot-screen { transition: opacity 0.5s ease-out; }
        
        /* 32. Dynamic Accordion */
        details > summary { list-style: none; }
        details > summary::-webkit-details-marker { display: none; }
        details[open] summary ~ * { animation: sweep .5s ease-in-out; }
        @keyframes sweep { 0% {opacity: 0; transform: translateY(-10px)} 100% {opacity: 1; transform: translateY(0)} }

        html { scroll-behavior: initial; } /* Let Lenis handle scroll */
        html.lenis, html.lenis body {
            height: auto;
        }
        .lenis.lenis-smooth {
            scroll-behavior: auto !important;
        }
        .lenis.lenis-smooth [data-lenis-prevent] {
            overscroll-behavior: contain;
        }
        .lenis.lenis-stopped {
            overflow: hidden;
        }
        .lenis.lenis-scrolling iframe {
            pointer-events: none;
        }
        
        /* 36. Nav Shrink */
        #main-nav { transition: padding 0.4s ease, background 0.4s ease, backdrop-filter 0.4s ease; }
        #main-nav.shrunk { padding-top: 1rem; padding-bottom: 1rem; background: rgba(5,5,5,0.7); backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,255,255,0.05); }
        
        /* 29. Flash Focus */
        .flash-focus { animation: flash-border 1.5s ease-out; }
        @keyframes flash-border { 0%, 50%, 100% { border-color: rgba(32, 184, 152, 1); box-shadow: 0 0 30px rgba(32, 184, 152, 0.5); } 25%, 75% { border-color: #222; box-shadow: none; } }
    </style>
</head>
<body>
    <!-- Category 1: Ultimate Background Layers -->
    <div class="ambient-mesh">
        <div class="global-grid"></div>
        <div class="blueprint-grid"></div>
        <div class="topo-pattern"></div>
        <div class="ascii-art">
   _._     _,-'""`-._
  (,-.`._,'(       |\`-/|
      `-.-' \ )-`( , o o)
            `-    \`_`"'-
        </div>
        <div class="flashlight-mask"></div>
    </div>
    <div class="tv-noise"></div>
    <div class="glass-edges"></div>
    
    <!-- Circular Scroll Progress -->
    <svg class="fixed bottom-8 right-8 w-12 h-12 z-[100] -rotate-90 pointer-events-none opacity-50" viewBox="0 0 100 100">
