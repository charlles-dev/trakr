# ===== Trakr - .gitignore mestre =====

# ---- Sistema ----
.DS_Store
Thumbs.db
*.swp
*~

# ===== Android / Gradle / Kotlin (app) =====
app/.gradle/
app/build/
app/local.properties
app/captures/
app/.idea
app/*.iml
app/.kotlin/
app/build/outputs/apk/
*.hprof
.kotlin/

# ===== PlatformIO / ESP32 (firmware) =====
firmware/.pio/
firmware/.pioenvs/
firmware/.piolibdeps/
firmware/libdeps/
firmware/.sconsign.dblite
firmware/.clang_complete
firmware/.clangd

# ===== Python (cad) =====
cad/scripts/__pycache__/
*.py[cod]
.venv/
venv/
env/

# ===== C/C++ =====
*.o
*.obj
*.exe
*.elf
*.bin
*.hex
*.map
*.a

# ===== CAD / fabricação =====
cad/exports/*.step
*.3mf
*.stl

# ===== Docs gerados / ferramentas =====
node_modules/
.env
.env.local
logs/
*.log

# ===== IDE =====
.idea/
.vscode/
*.code-workspace