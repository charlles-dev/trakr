<?xml version="1.0" encoding="utf-8"?>
<!--
    Regras de extração de dados (Android 12+).

    O Room é um cache local re-sincronizado pelo rastreador BLE: restaurar o
    banco antigo em outro aparelho mostraria estado inconsistente, então o
    backup em nuvem exclui banco e preferências. Na transferência entre
    dispositivos (device-to-device) o conteúdo completo é incluído.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="trakr.db" />
        <exclude domain="database" path="trakr.db-wal" />
        <exclude domain="database" path="trakr.db-shm" />
        <exclude domain="sharedpref" path="trakr_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>